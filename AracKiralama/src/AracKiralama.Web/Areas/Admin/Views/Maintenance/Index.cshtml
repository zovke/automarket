@model List<Maintenance>
@{
    ViewData["Title"] = "Bakım";
    var openOnly = (bool)ViewBag.OpenOnly;
    var totalCost = (decimal)ViewBag.TotalCost;
}
<div class="page-head">
    <div><h1>Bakım Kayıtları</h1><div class="sub">Toplam bakım maliyeti: <b>@Fmt.Money(totalCost)</b></div></div>
    <div class="d-flex gap-2">
        <a asp-route-openOnly="@(!openOnly)" class="btn btn-ghost">@(openOnly ? "Tümünü göster" : "Sadece açık olanlar")</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Bakım kaydı</a>
    </div>
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Araç</th><th>Tür</th><th>Tarih</th><th class="text-end">Km</th><th class="text-end">Maliyet</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>
                            <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@m.VehicleId" class="fw-semibold text-reset">@m.Vehicle!.DisplayName</a>
                            <div><span class="kbd-plate">@m.Vehicle!.Plate</span></div>
                        </td>
                        <td>@m.Type.GetDisplayName()<div class="small text-muted">@m.Description</div></td>
                        <td class="small">@Fmt.DateTime(m.StartDate)<br /><span class="text-muted">→ @Fmt.DateTime(m.EndDate)</span></td>
                        <td class="text-end tabular small">@Fmt.Number(m.Kilometers)</td>
                        <td class="text-end tabular fw-semibold">@Fmt.Money(m.Cost)</td>
                        <td>@if (m.IsCompleted) { <span class="status status-completed">Tamamlandı</span> } else { <span class="status status-maintenance">Devam ediyor</span> }</td>
                        <td class="text-end text-nowrap">
                            @if (!m.IsCompleted)
                            {
                                <form asp-action="Complete" asp-route-id="@m.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-soft">Tamamla</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@m.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-ghost text-danger" data-confirm="Bakım kaydı silinsin mi?" aria-label="Sil"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-tools"></i>Kayıt yok.</div> }
</div>
