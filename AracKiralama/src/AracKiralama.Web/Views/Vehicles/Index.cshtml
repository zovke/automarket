@model VehicleListViewModel
@{
    ViewData["Title"] = "Araçlar";
    var f = Model.Filter;
    var branchName = Model.Branches.FirstOrDefault(b => b.Id == f.PickupBranchId)?.Name;
}

<div class="bg-brand-soft border-bottom">
    <div class="container py-4">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
            <div>
                <h1 class="h3 mb-1">Kiralık Araçlar</h1>
                <div class="text-muted">
                    @if (f.HasDates)
                    {
                        <span><i class="bi bi-calendar-range me-1"></i>@Fmt.DateTime(f.Start!.Value) → @Fmt.DateTime(f.End!.Value) · <b>@Model.Days gün</b> için müsait araçlar</span>
                    }
                    else
                    {
                        <span>Müsaitlik görmek için alış ve iade tarihini seçin.</span>
                    }
                    @if (branchName is not null) { <span> · @branchName</span> }
                </div>
            </div>
        </div>
        <div class="card p-3">
            <partial name="_SearchForm" model="(f, Model.Branches)" />
        </div>
    </div>
</div>

<div class="container py-4">
    <div class="row g-4">
        <aside class="col-lg-3">
            <form method="get" class="card p-3 filter-panel" data-auto-submit>
                @* Tarih / şube seçimi korunur *@
                @foreach (var kv in f.ToSearchRouteValues())
                {
                    <input type="hidden" name="@kv.Key" value="@kv.Value" />
                }
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold"><i class="bi bi-sliders me-1"></i>Filtreler</span>
                    <a asp-action="Index" asp-all-route-data="f.ToSearchRouteValues()" class="small">Temizle</a>
                </div>

                <div class="filter-group">
                    <div class="small-caps mb-2">Kategori</div>
                    <div class="option-pills">
                        <input type="radio" name="Category" id="cat-all" value="" checked="@(f.Category is null)" /><label for="cat-all">Tümü</label>
                        @foreach (var c in Enum.GetValues<VehicleCategory>())
                        {
                            <input type="radio" name="Category" id="cat-@c" value="@c" checked="@(f.Category == c)" /><label for="cat-@c">@c.GetDisplayName()</label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <div class="small-caps mb-2">Vites</div>
                    <div class="option-pills">
                        <input type="radio" name="Transmission" id="tr-all" value="" checked="@(f.Transmission is null)" /><label for="tr-all">Tümü</label>
                        @foreach (var t in Enum.GetValues<TransmissionType>())
                        {
                            <input type="radio" name="Transmission" id="tr-@t" value="@t" checked="@(f.Transmission == t)" /><label for="tr-@t">@t.GetDisplayName()</label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <div class="small-caps mb-2">Yakıt</div>
                    <select class="form-select form-select-sm" name="Fuel">
                        <option value="">Tümü</option>
                        @foreach (var fu in Enum.GetValues<FuelType>())
                        {
                            <option value="@fu" selected="@(f.Fuel == fu)">@fu.GetDisplayName()</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <div class="small-caps mb-2">Koltuk</div>
                    <div class="option-pills">
                        @foreach (var (val, label) in new (int?, string)[] { (null, "Tümü"), (5, "5+"), (7, "7+") })
                        {
                            <input type="radio" name="MinSeats" id="seat-@(val ?? 0)" value="@val" checked="@(f.MinSeats == val)" /><label for="seat-@(val ?? 0)">@label</label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <div class="small-caps mb-2">Günlük en fazla</div>
                    <select class="form-select form-select-sm" name="MaxPrice">
                        <option value="">Fark etmez</option>
                        @foreach (var p in new[] { 1000, 1500, 2000, 3000 })
                        {
                            <option value="@p" selected="@(f.MaxPrice == p)">@Fmt.Money(p)</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <div class="small-caps mb-2">Sıralama</div>
                    <select class="form-select form-select-sm" name="Sort">
                        <option value="price-asc" selected="@(f.Sort == "price-asc")">Fiyat (artan)</option>
                        <option value="price-desc" selected="@(f.Sort == "price-desc")">Fiyat (azalan)</option>
                        <option value="newest" selected="@(f.Sort == "newest")">En yeni model</option>
                    </select>
                </div>
                <noscript><button class="btn btn-primary w-100 mt-3">Uygula</button></noscript>
            </form>
        </aside>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="text-muted"><b class="text-body">@Model.Vehicles.TotalCount</b> araç bulundu</div>
            </div>

            @if (Model.Vehicles.Items.Count == 0)
            {
                <div class="card empty-state">
                    <i class="bi bi-car-front"></i>
                    <h2 class="h5 text-body">Kriterlere uygun araç bulunamadı</h2>
                    <p class="mb-3">Farklı tarihler deneyebilir veya filtreleri gevşetebilirsiniz.</p>
                    <a asp-action="Index" class="btn btn-soft">Filtreleri temizle</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var v in Model.Vehicles.Items)
                    {
                        <div class="col-sm-6 col-xl-4">
                            <partial name="_VehicleCard" model="new VehicleCardViewModel { Vehicle = v, Search = f, Days = Model.Days }" />
                        </div>
                    }
                </div>
                @await Html.PartialAsync("_Pagination", (Model.Vehicles.TotalPages, Model.Vehicles.Page,
                    (Func<int, string>)(p => Url.Action("Index", f.ToRouteValues(p))!)))
            }
        </div>
    </div>
</div>
