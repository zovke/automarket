@model DeliverViewModel
@{
    var r = Model.Reservation!;
    ViewData["Title"] = "Araç teslimi";
}
<div class="page-head">
    <div>
        <a asp-action="Details" asp-route-id="@r.Id" class="small"><i class="bi bi-arrow-left me-1"></i>@r.Code</a>
        <h1 class="mt-1">Aracı teslim et</h1>
        <div class="sub">@r.Customer!.FullName · @r.Vehicle!.DisplayName <span class="kbd-plate">@r.Vehicle.Plate</span></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <form asp-action="Deliver" method="post" class="card">
            <input type="hidden" asp-for="ReservationId" />
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="StartKm" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="StartKm" class="form-control" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="StartKm"></span>
                        <div class="form-text">Kayıtlı: @Fmt.Number(r.Vehicle.Kilometers) km</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FuelLevelOut" class="form-label"></label>
                        <select asp-for="FuelLevelOut" class="form-select" asp-items="Html.GetEnumSelectList<FuelLevel>()"></select>
                    </div>
                    <div class="col-12">
                        <div class="card-soft p-3 small">
                            <div class="fw-semibold mb-1"><i class="bi bi-list-check me-1"></i>Teslim kontrol listesi</div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="c1" required /><label class="form-check-label" for="c1">Müşterinin kimlik ve ehliyet aslı görüldü</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="c2" required /><label class="form-check-label" for="c2">Depozito (@Fmt.Money(r.Deposit)) alındı</label></div>
                            <div class="form-check"><input class="form-check-input" type="checkbox" id="c3" required /><label class="form-check-label" for="c3">Araç çevresi müşteriyle birlikte kontrol edildi</label></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body border-top d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-ghost">Vazgeç</a>
                <button class="btn btn-primary"><i class="bi bi-key me-1"></i>Teslim et</button>
            </div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <div class="small-caps">Planlanan</div>
                <div class="fw-semibold">@Fmt.DateTime(r.StartDate) → @Fmt.DateTime(r.EndDate)</div>
                <div class="small text-muted mb-3">@r.PickupBranch!.Name → @r.ReturnBranch!.Name · @r.TotalDays gün</div>
                @if (r.Extras.Count > 0)
                {
                    <div class="small-caps mb-1">Ek hizmetler (araçla birlikte verilecek)</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var e in r.Extras) { <span class="chip"><i class="bi @e.Extra!.Icon"></i>@e.Extra.Name</span> }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
