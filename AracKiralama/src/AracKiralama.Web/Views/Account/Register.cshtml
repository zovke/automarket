@model RegisterViewModel
@{
    ViewData["Title"] = "Üye Ol";
}
<div class="auth-wrap">
    <div class="auth-side">
        <h2 class="mb-2">Dakikalar içinde yola çıkın.</h2>
        <p class="opacity-75 mb-0">Üyelik ücretsizdir. Ehliyet bilgilerinizi bir kez girin, sonraki rezervasyonlarınız tek tık.</p>
    </div>
    <div class="auth-form">
        <div class="inner">
            <h1 class="h3 mb-1">Hesap oluştur</h1>
            <p class="text-muted mb-4">Zaten üye misiniz? <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Giriş yapın</a></p>

            <form asp-action="Register" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="row g-3">
                    <div class="col-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="05xx xxx xx xx" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input type="checkbox" name="AcceptKvkk" id="AcceptKvkk" value="true" class="form-check-input" checked="@Model.AcceptKvkk" />
                            <label for="AcceptKvkk" class="form-check-label small">
                                <a asp-controller="Home" asp-action="Privacy" target="_blank">KVKK aydınlatma metnini</a> okudum, kişisel verilerimin işlenmesini kabul ediyorum.
                            </label>
                            <div><span asp-validation-for="AcceptKvkk"></span></div>
                        </div>
                    </div>
                </div>
                <button class="btn btn-primary btn-lg w-100 mt-4" type="submit">Üye Ol</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
