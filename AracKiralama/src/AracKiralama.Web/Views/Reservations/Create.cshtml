@model ReservationCreateViewModel
@{
    var v = Model.Vehicle!;
    ViewData["Title"] = "Rezervasyon";
    var c = Model.Customer;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var hasErrors = !ViewData.ModelState.IsValid;
}

<div class="container py-4">
    <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@v.Id" class="small"><i class="bi bi-arrow-left me-1"></i>Araç detayına dön</a>
    <h1 class="h3 mt-2 mb-4">Rezervasyonu tamamla</h1>

    <div class="wizard-steps mb-4" id="wizardSteps">
        <div class="step active" data-step-indicator="1"><span class="num">1</span><span class="lbl">Tarih & Şube</span></div>
        <div class="step" data-step-indicator="2"><span class="num">2</span><span class="lbl">Ek Hizmetler</span></div>
        <div class="step" data-step-indicator="3"><span class="num">3</span><span class="lbl">Özet & Onay</span></div>
    </div>

    <form asp-action="Create" method="post" data-quote-form data-vehicle-id="@v.Id" id="wizard" data-start-step="@(hasErrors ? 3 : 1)">
        <input type="hidden" asp-for="VehicleId" />
        <div class="row g-4">
            <div class="col-lg-8">
                @if (hasErrors)
                {
                    <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>
                }

                @* ---------- ADIM 1 ---------- *@
                <section class="wizard-pane card" data-step="1">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Ne zaman, nereden?</h2>
                        <div class="row g-3" data-date-pair>
                            <div class="col-md-6">
                                <label asp-for="Start" class="form-label"></label>
                                <input asp-for="Start" type="datetime-local" class="form-control" value="@Fmt.Input(Model.Start)" min="@Fmt.Input(DateTime.Today)" data-date-start />
                                <span asp-validation-for="Start"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="End" class="form-label"></label>
                                <input asp-for="End" type="datetime-local" class="form-control" value="@Fmt.Input(Model.End)" data-date-end />
                                <span asp-validation-for="End"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PickupBranchId" class="form-label"></label>
                                <select asp-for="PickupBranchId" class="form-select" asp-items="@(new SelectList(Model.Branches, "Id", "Name"))"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReturnBranchId" class="form-label"></label>
                                <select asp-for="ReturnBranchId" class="form-select" asp-items="@(new SelectList(Model.Branches, "Id", "Name"))"></select>
                                <div class="form-text">Farklı şubeye iadede tek yön ücreti eklenir.</div>
                            </div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-primary" data-step-go="2">Devam <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </div>
                </section>

                @* ---------- ADIM 2 ---------- *@
                <section class="wizard-pane card" data-step="2">
                    <div class="card-body">
                        <h2 class="h5 mb-1">Ek hizmet ister misiniz?</h2>
                        <p class="text-muted small mb-3">Tüm ek hizmetler günlük ücretlendirilir ve istediğiniz zaman şubede değiştirilebilir.</p>
                        <div class="row g-2">
                            @foreach (var x in Model.Extras)
                            {
                                <div class="col-md-6">
                                    <label class="extra-option">
                                        <input type="checkbox" name="ExtraIds" value="@x.Id" checked="@Model.ExtraIds.Contains(x.Id)" />
                                        <span class="box">
                                            <span class="ico"><i class="bi @x.Icon"></i></span>
                                            <span>
                                                <b>@x.Name</b> <span class="text-muted small">+@Fmt.Money(x.DailyPrice)/gün</span>
                                                <span class="d-block small text-muted">@x.Description</span>
                                            </span>
                                            <i class="bi bi-check-circle-fill check fs-5"></i>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>
                        <div class="mt-3">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Uçuş numaranız, özel isteğiniz..."></textarea>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-ghost" data-step-go="1"><i class="bi bi-arrow-left me-1"></i>Geri</button>
                            <button type="button" class="btn btn-primary" data-step-go="3">Devam <i class="bi bi-arrow-right ms-1"></i></button>
                        </div>
                    </div>
                </section>

                @* ---------- ADIM 3 ---------- *@
                <section class="wizard-pane card" data-step="3">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Sürücü bilgileri</h2>
                        @if (c is not null)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-sm-6"><div class="small-caps">Ad Soyad</div><div class="fw-semibold">@c.FullName</div></div>
                                <div class="col-sm-6"><div class="small-caps">E-posta</div><div class="fw-semibold">@c.Email</div></div>
                                <div class="col-sm-6"><div class="small-caps">Doğum tarihi</div><div class="fw-semibold">@(c.BirthDate is { } bd ? Fmt.Date(bd) : "—")</div></div>
                                <div class="col-sm-6"><div class="small-caps">Ehliyet tarihi</div><div class="fw-semibold">@(c.LicenseIssueDate is { } ld ? Fmt.Date(ld) : "—")</div></div>
                            </div>
                        }

                        @if (Model.EligibilityErrors.Count > 0)
                        {
                            <div class="alert alert-warning">
                                <div class="fw-semibold mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Bu araç için kiralama şartlarını karşılamıyorsunuz</div>
                                <ul class="mb-2 ps-3 small">
                                    @foreach (var e in Model.EligibilityErrors) { <li>@e</li> }
                                </ul>
                                <a asp-controller="Profile" asp-action="Edit" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-ghost">Profil bilgilerimi güncelle</a>
                                <a asp-controller="Vehicles" asp-action="Index" asp-route-Category="Economy" class="btn btn-sm btn-ghost">Başka araç seç</a>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success small"><i class="bi bi-check-circle me-1"></i>Sürücü yaşı ve ehliyet süresi bu araç için uygun.</div>
                        }

                        <div class="form-check mt-3">
                            @* Onay kutusu elle yazıldı: [Range] doğrulaması checkbox için sadece sunucuda çalışır. *@
                            <input type="checkbox" name="AcceptTerms" id="AcceptTerms" value="true" class="form-check-input" checked="@Model.AcceptTerms" />
                            <label asp-for="AcceptTerms" class="form-check-label"></label>
                            (<a asp-controller="Home" asp-action="Terms" target="_blank">oku</a>)
                            <div><span asp-validation-for="AcceptTerms"></span></div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-ghost" data-step-go="2"><i class="bi bi-arrow-left me-1"></i>Geri</button>
                            <button type="submit" class="btn btn-primary btn-lg" data-quote-submit data-locked="@(Model.EligibilityErrors.Count > 0 ? "true" : "false")" disabled="@(Model.EligibilityErrors.Count > 0)">
                                <i class="bi bi-check2-circle me-1"></i>Talebi Gönder
                            </button>
                        </div>
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <div class="card booking-card">
                    <img src="@v.ImageUrl" alt="@v.DisplayName" class="card-img-top" style="aspect-ratio:16/9;object-fit:cover;border-radius:var(--radius) var(--radius) 0 0" />
                    <div class="card-body">
                        <h3 class="h5 mb-1">@v.DisplayName</h3>
                        <div class="specs mb-3">
                            <span><i class="bi bi-gear-wide-connected"></i>@v.Transmission.GetDisplayName()</span>
                            <span><i class="bi bi-fuel-pump"></i>@v.Fuel.GetDisplayName()</span>
                            <span><i class="bi bi-people"></i>@v.Seats</span>
                        </div>
                        <div data-quote-errors></div>
                        <ul class="breakdown" data-quote-breakdown>
                            <li><span>Fiyat hesaplanıyor…</span><span></span></li>
                        </ul>
                        <div class="small text-muted mt-2">Depozito: <b data-quote-deposit>@Fmt.Money(v.Deposit)</b> (teslimde alınır, iadede geri verilir)</div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/price-quote.js" asp-append-version="true"></script>
    <script>
        // 3 adımlı sihirbaz: aynı form içinde bölümleri sırayla gösterir.
        (function () {
            const form = document.getElementById("wizard");
            const panes = form.querySelectorAll("[data-step]");
            const indicators = document.querySelectorAll("[data-step-indicator]");
            function go(step) {
                panes.forEach(p => p.classList.toggle("active", p.dataset.step == step));
                indicators.forEach(i => {
                    const n = Number(i.dataset.stepIndicator);
                    i.classList.toggle("active", n == step);
                    i.classList.toggle("done", n < step);
                });
                window.scrollTo({ top: 0, behavior: "smooth" });
            }
            form.querySelectorAll("[data-step-go]").forEach(b => b.addEventListener("click", () => go(Number(b.dataset.stepGo))));
            go(Number(form.dataset.startStep || 1));
        })();
    </script>
}
