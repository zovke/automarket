@model PagedList<Payment>
@{
    ViewData["Title"] = "Ödemeler";
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
    var method = (PaymentMethod?)ViewBag.Method;
    var type = (PaymentType?)ViewBag.Type;
    var byMethod = (Dictionary<PaymentMethod, decimal>)ViewBag.ByMethod;
    var total = (decimal)ViewBag.Total;
}
<div class="page-head">
    <div><h1>Ödemeler</h1><div class="sub">@Fmt.Date(from) – @Fmt.Date(to) arası kasa hareketleri</div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3">@await Html.PartialAsync("_KpiCard", new KpiModel("Toplam", Fmt.Money(total), "bi-wallet2", "brand"))</div>
    @foreach (var m in Enum.GetValues<PaymentMethod>())
    {
        <div class="col-md-3">@await Html.PartialAsync("_KpiCard", new KpiModel(m.GetDisplayName(), Fmt.Money(byMethod.GetValueOrDefault(m)), m switch { PaymentMethod.Cash => "bi-cash", PaymentMethod.CreditCard => "bi-credit-card", _ => "bi-bank" }, "info"))</div>
    }
</div>

<div class="card table-card">
    <form method="get" class="card-header d-flex flex-wrap gap-2 align-items-center" data-auto-submit>
        <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" class="form-control" style="width:auto" aria-label="Başlangıç" />
        <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" class="form-control" style="width:auto" aria-label="Bitiş" />
        <select name="method" class="form-select" style="width:auto">
            <option value="">Tüm yöntemler</option>
            @foreach (var m in Enum.GetValues<PaymentMethod>()) { <option value="@m" selected="@(method == m)">@m.GetDisplayName()</option> }
        </select>
        <select name="type" class="form-select" style="width:auto">
            <option value="">Tüm türler</option>
            @foreach (var t in Enum.GetValues<PaymentType>()) { <option value="@t" selected="@(type == t)">@t.GetDisplayName()</option> }
        </select>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Tarih</th><th>Rezervasyon</th><th>Müşteri</th><th>Tür</th><th>Yöntem</th><th>Alan</th><th class="text-end">Tutar</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td class="small">@Fmt.DateTime(p.PaidAt)</td>
                        <td><a asp-controller="Reservations" asp-action="Details" asp-route-id="@p.ReservationId" class="tabular">@p.Reservation!.Code</a></td>
                        <td>@p.Reservation!.Customer!.FullName</td>
                        <td>@p.Type.GetDisplayName()</td>
                        <td>@p.Method.GetDisplayName()</td>
                        <td class="small text-muted">@(p.ReceivedBy?.FullName ?? "-")</td>
                        <td class="text-end tabular fw-semibold">@Fmt.Money(p.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count == 0) { <div class="empty-state"><i class="bi bi-wallet2"></i>Bu aralıkta ödeme yok.</div> }
</div>

@await Html.PartialAsync("_Pagination", (Model.TotalPages, Model.Page,
    (Func<int, string>)(pg => Url.Action("Index", new { from = from.ToString("yyyy-MM-dd"), to = to.ToString("yyyy-MM-dd"), method, type, page = pg })!)))
