@model StaffCreateViewModel
@{
    ViewData["Title"] = "Personel ekle";
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Personel & Roller</a>
        <h1 class="mt-1">Personel ekle</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="card" style="max-width:640px" novalidate>
    <div class="card-body row g-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small col-12"></div>
        <div class="col-md-6">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName"></span>
        </div>
        <div class="col-12">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" class="form-select">
                <option value="@Roles.Staff">Personel</option>
                <option value="@Roles.Admin">Admin</option>
            </select>
        </div>
    </div>
    <div class="card-body border-top d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
        <button class="btn btn-primary">Oluştur</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
