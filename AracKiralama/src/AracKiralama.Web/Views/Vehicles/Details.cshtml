@model VehicleDetailsViewModel
@{
    var v = Model.Vehicle;
    ViewData["Title"] = v.DisplayName;
    var start = Model.Search.Start ?? DateTime.Today.AddDays(1).AddHours(10);
    var end = Model.Search.End ?? start.AddDays(3);
    var pickup = Model.Search.PickupBranchId ?? v.BranchId;
    var drop = Model.Search.ReturnBranchId ?? pickup;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" asp-all-route-data="Model.Search.ToSearchRouteValues()">Araçlar</a></li>
            <li class="breadcrumb-item active">@v.DisplayName</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="detail-media mb-4">
                <img src="@(v.ImageUrl ?? "/img/placeholder.svg")" alt="@v.DisplayName" />
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="chip">@v.Category.GetDisplayName()</span>
                <span class="chip"><i class="bi bi-geo-alt"></i>@v.Branch!.Name</span>
                @if (v.Brand?.LogoUrl is not null)
                {
                    <img src="@v.Brand.LogoUrl" alt="@v.Brand.Name" height="22" class="ms-1" />
                }
            </div>
            <h1 class="h2 mb-1">@v.DisplayName <span class="text-muted fw-normal">@v.Year</span></h1>
            <p class="text-muted mb-4">@v.Description</p>

            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3"><div class="spec-tile"><i class="bi bi-gear-wide-connected"></i><div class="label">Vites</div><div class="value">@v.Transmission.GetDisplayName()</div></div></div>
                <div class="col-6 col-md-3"><div class="spec-tile"><i class="bi bi-fuel-pump"></i><div class="label">Yakıt</div><div class="value">@v.Fuel.GetDisplayName()</div></div></div>
                <div class="col-6 col-md-3"><div class="spec-tile"><i class="bi bi-people"></i><div class="label">Koltuk</div><div class="value">@v.Seats kişi</div></div></div>
                <div class="col-6 col-md-3"><div class="spec-tile"><i class="bi bi-palette"></i><div class="label">Renk</div><div class="value">@v.Color</div></div></div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><i class="bi bi-card-checklist me-2 text-brand"></i>Kiralama şartları</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="small-caps">Sürücü yaşı</div>
                            <div class="fw-semibold">En az @v.MinDriverAge</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="small-caps">Ehliyet süresi</div>
                            <div class="fw-semibold">En az @v.MinLicenseYears yıl</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="small-caps">Depozito</div>
                            <div class="fw-semibold">@Fmt.Money(v.Deposit) <span class="text-muted small fw-normal">(iadede geri ödenir)</span></div>
                        </div>
                    </div>
                    <div class="divider"></div>
                    <ul class="small text-muted mb-0 ps-3">
                        <li>7 gün ve üzeri kiralamalarda %10, 30 gün ve üzeri kiralamalarda %20 indirim otomatik uygulanır.</li>
                        <li>Farklı şubeye iadede tek yön ücreti eklenir.</li>
                        <li>Alış saatine 24 saatten fazla varken iptal ücretsizdir.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <form class="card booking-card" method="get" asp-controller="Reservations" asp-action="Create"
                  data-quote-form data-vehicle-id="@v.Id">
                <input type="hidden" name="vehicleId" value="@v.Id" />
                <div class="card-body">
                    <div class="d-flex align-items-baseline justify-content-between mb-3">
                        <div class="price fs-3">@Fmt.Money(v.DailyPrice) <small>/ gün</small></div>
                        @if (Model.IsAvailable == true) { <span class="status status-available">Müsait</span> }
                        else if (Model.IsAvailable == false) { <span class="status status-rejected">Dolu</span> }
                    </div>

                    <div class="row g-2 mb-2" data-date-pair>
                        <div class="col-6">
                            <label class="form-label small" for="q-start">Alış</label>
                            <input class="form-control form-control-sm" type="datetime-local" id="q-start" name="Start" value="@Fmt.Input(start)" min="@Fmt.Input(DateTime.Today)" data-date-start />
                        </div>
                        <div class="col-6">
                            <label class="form-label small" for="q-end">İade</label>
                            <input class="form-control form-control-sm" type="datetime-local" id="q-end" name="End" value="@Fmt.Input(end)" data-date-end />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small" for="q-pickup">Alış şubesi</label>
                            <select class="form-select form-select-sm" id="q-pickup" name="PickupBranchId">
                                @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(b.Id == pickup)">@b.Name</option> }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small" for="q-return">İade şubesi</label>
                            <select class="form-select form-select-sm" id="q-return" name="ReturnBranchId">
                                @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(b.Id == drop)">@b.Name</option> }
                            </select>
                        </div>
                    </div>

                    <div class="small-caps mb-2">Ek hizmetler</div>
                    <div class="d-grid gap-2 mb-3">
                        @foreach (var x in Model.Extras.Take(4))
                        {
                            <label class="extra-option">
                                <input type="checkbox" name="ExtraIds" value="@x.Id" />
                                <span class="box py-2">
                                    <span class="ico" style="width:32px;height:32px"><i class="bi @x.Icon"></i></span>
                                    <span class="small"><b>@x.Name</b><br /><span class="text-muted">+@Fmt.Money(x.DailyPrice) / gün</span></span>
                                    <i class="bi bi-check-circle-fill check"></i>
                                </span>
                            </label>
                        }
                    </div>

                    <div data-quote-errors></div>
                    <ul class="breakdown mb-3" data-quote-breakdown>
                        <li><span>Fiyat hesaplanıyor…</span><span></span></li>
                    </ul>

                    <button class="btn btn-primary btn-lg w-100" type="submit" data-quote-submit>
                        Rezervasyon Yap <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                    <div class="small text-muted text-center mt-2"><i class="bi bi-lock me-1"></i>Şimdi ödeme alınmaz, onaydan sonra şubede ödenir.</div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Similar.Count > 0)
    {
        <section class="mt-5">
            <h2 class="h4 mb-3">Benzer araçlar</h2>
            <div class="row g-4">
                @foreach (var s in Model.Similar)
                {
                    <div class="col-sm-6 col-lg-3">
                        <partial name="_VehicleCard" model="new VehicleCardViewModel { Vehicle = s, Search = Model.Search }" />
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script src="~/js/price-quote.js" asp-append-version="true"></script>
}
