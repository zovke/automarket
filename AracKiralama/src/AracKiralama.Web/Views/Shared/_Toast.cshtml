@* Controller'da ShowSuccess("...") / ShowError("...") çağrıldığında bir sonraki sayfada görünen bildirim. *@
@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
}
@if (success is not null || error is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @if (success is not null)
        {
            <div class="toast align-items-center" role="status" aria-live="polite">
                <div class="d-flex align-items-center gap-3 p-3">
                    <span class="toast-icon ico-success"><i class="bi bi-check-lg"></i></span>
                    <div class="small fw-medium">@success</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        }
        @if (error is not null)
        {
            <div class="toast align-items-center" role="alert" aria-live="assertive">
                <div class="d-flex align-items-center gap-3 p-3">
                    <span class="toast-icon ico-danger"><i class="bi bi-exclamation-lg"></i></span>
                    <div class="small fw-medium">@error</div>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
                </div>
            </div>
        }
    </div>
}
