<footer class="site-footer">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-4">
                <a class="brand-logo mb-3" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-signpost-split-fill"></i></span>
                    @Site.Value.Name
                </a>
                <p class="small mb-3" style="max-width: 22rem">Türkiye'nin dört bir yanındaki şubelerimizde, şeffaf fiyat ve sürprizsiz kiralama deneyimi.</p>
                <div class="d-flex gap-3 fs-5">
                    <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                    <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                </div>
            </div>
            <div class="col-6 col-lg-2">
                <h6 class="mb-3">Kiralama</h6>
                <ul class="list-unstyled small d-grid gap-2">
                    <li><a asp-controller="Vehicles" asp-action="Index">Tüm Araçlar</a></li>
                    <li><a asp-controller="Vehicles" asp-action="Index" asp-route-Category="Economy">Ekonomik</a></li>
                    <li><a asp-controller="Vehicles" asp-action="Index" asp-route-Category="Suv">SUV</a></li>
                    <li><a asp-controller="Vehicles" asp-action="Index" asp-route-Category="Luxury">Lüks</a></li>
                </ul>
            </div>
            <div class="col-6 col-lg-2">
                <h6 class="mb-3">Kurumsal</h6>
                <ul class="list-unstyled small d-grid gap-2">
                    <li><a asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">İletişim</a></li>
                    <li><a asp-controller="Home" asp-action="Terms">Kiralama Koşulları</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">KVKK</a></li>
                </ul>
            </div>
            <div class="col-lg-4">
                <h6 class="mb-3">Bize ulaşın</h6>
                <ul class="list-unstyled small d-grid gap-2">
                    <li><i class="bi bi-telephone me-2"></i>@Site.Value.Phone</li>
                    <li><i class="bi bi-envelope me-2"></i>@Site.Value.Email</li>
                    <li><i class="bi bi-geo-alt me-2"></i>@Site.Value.Address</li>
                </ul>
            </div>
        </div>
        <div class="bottom d-flex flex-wrap justify-content-between gap-2">
            <span>© @DateTime.Now.Year @Site.Value.Name @Site.Value.Tagline · Proje ödevi amaçlı geliştirilmiştir.</span>
            <a href="/swagger" target="_blank"><i class="bi bi-braces me-1"></i>API Dokümantasyonu</a>
        </div>
    </div>
</footer>
