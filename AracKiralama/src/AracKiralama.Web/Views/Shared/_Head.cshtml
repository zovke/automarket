@* Hem site hem yönetim paneli layout'unda kullanılan ortak <head> içeriği.
   Bütün dosyalar yereldir (wwwroot/lib) → internet olmadan da çalışır ve CSP'ye takılmaz. *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@(ViewData["Title"] is string t ? $"{t} · {Site.Value.Name}" : $"{Site.Value.Name} {Site.Value.Tagline}")</title>
@* Tema tercihini sayfa çizilmeden önce uygular (yanıp sönmeyi engeller); bu yüzden defer/async YOK. *@
<script src="~/js/theme-init.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/lib/inter/inter.css" />
<link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%232747d6'/><text x='16' y='22' font-size='16' text-anchor='middle' fill='white' font-family='Arial' font-weight='bold'>R</text></svg>" />
