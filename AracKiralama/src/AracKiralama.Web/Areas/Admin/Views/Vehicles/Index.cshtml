@model PagedList<Vehicle>
@{
    ViewData["Title"] = "Araçlar";
    var branches = (List<Branch>)ViewBag.Branches;
    var q = (string?)ViewBag.Q;
    var category = (VehicleCategory?)ViewBag.Category;
    var status = (VehicleStatus?)ViewBag.Status;
    var branchId = (int?)ViewBag.BranchId;
}

<div class="page-head">
    <div>
        <h1>Araçlar</h1>
        <div class="sub">Filodaki @Model.TotalCount araç</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni araç</a>
</div>

<div class="card table-card">
    <form method="get" class="card-header d-flex flex-wrap gap-2 align-items-center" data-auto-submit>
        <div class="input-group" style="max-width:300px">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="q" value="@q" class="form-control" placeholder="Plaka, marka veya model" />
        </div>
        <select name="category" class="form-select" style="width:auto">
            <option value="">Tüm kategoriler</option>
            @foreach (var c in Enum.GetValues<VehicleCategory>()) { <option value="@c" selected="@(category == c)">@c.GetDisplayName()</option> }
        </select>
        <select name="status" class="form-select" style="width:auto">
            <option value="">Tüm durumlar</option>
            @foreach (var s in Enum.GetValues<VehicleStatus>()) { <option value="@s" selected="@(status == s)">@s.GetDisplayName()</option> }
        </select>
        <select name="branchId" class="form-select" style="width:auto">
            <option value="">Tüm şubeler</option>
            @foreach (var b in branches) { <option value="@b.Id" selected="@(branchId == b.Id)">@b.Name</option> }
        </select>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Araç</th><th>Plaka</th><th>Kategori</th><th>Şube</th><th class="text-end">Km</th><th class="text-end">Günlük</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var v in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(v.ImageUrl ?? "/img/placeholder.svg")" alt="" class="thumb" />
                                <div>
                                    <a asp-action="Details" asp-route-id="@v.Id" class="fw-semibold text-reset">@v.DisplayName</a>
                                    <div class="small text-muted">@v.Year · @v.Transmission.GetDisplayName() · @v.Fuel.GetDisplayName()</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="kbd-plate">@v.Plate</span></td>
                        <td>@v.Category.GetDisplayName()</td>
                        <td class="small">@v.Branch!.Name</td>
                        <td class="text-end tabular small">@Fmt.Number(v.Kilometers)</td>
                        <td class="text-end tabular fw-semibold">@Fmt.Money(v.DailyPrice)</td>
                        <td><partial name="_VehicleStatusBadge" model="v.Status" /></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-ghost" aria-label="Düzenle"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-ghost" aria-label="Detay"><i class="bi bi-chevron-right"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count == 0) { <div class="empty-state"><i class="bi bi-car-front"></i>Araç bulunamadı.</div> }
</div>

@await Html.PartialAsync("_Pagination", (Model.TotalPages, Model.Page,
    (Func<int, string>)(p => Url.Action("Index", new { q, category, status, branchId, page = p })!)))
