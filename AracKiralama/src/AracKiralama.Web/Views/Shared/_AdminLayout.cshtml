@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => controller == c ? "active" : "";
    var isAdmin = User.IsInRole(Roles.Admin);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="admin-body">
    <div class="admin-shell">
        @* lg ve üstünde sabit kenar çubuğu, mobilde açılır menü (Bootstrap offcanvas-lg) *@
        <aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar">
            <div class="offcanvas-body">
                <div class="brand-area d-flex align-items-center justify-content-between">
                    <a class="brand-logo" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <span class="brand-mark"><i class="bi bi-signpost-split-fill"></i></span>
                        @Site.Value.Name <small>Panel</small>
                    </a>
                    <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Kapat"></button>
                </div>

                <nav class="admin-nav">
                    <div class="group-label">Genel</div>
                    <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i>Gösterge Paneli</a>
                    <a class="@Active("Calendar")" asp-area="Admin" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar3-range"></i>Doluluk Takvimi</a>

                    <div class="group-label">Operasyon</div>
                    <a class="@Active("Reservations")" asp-area="Admin" asp-controller="Reservations" asp-action="Index"><i class="bi bi-journal-check"></i>Rezervasyonlar @await Component.InvokeAsync("PendingBadge")</a>
                    <a class="@Active("Vehicles")" asp-area="Admin" asp-controller="Vehicles" asp-action="Index"><i class="bi bi-car-front"></i>Araçlar</a>
                    <a class="@Active("Maintenance")" asp-area="Admin" asp-controller="Maintenance" asp-action="Index"><i class="bi bi-tools"></i>Bakım</a>
                    <a class="@Active("Payments")" asp-area="Admin" asp-controller="Payments" asp-action="Index"><i class="bi bi-wallet2"></i>Ödemeler</a>
                    <a class="@Active("Customers")" asp-area="Admin" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i>Müşteriler</a>

                    <div class="group-label">Analiz ve Tanımlar</div>
                    <a class="@Active("Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart-line"></i>Raporlar</a>
                    <a class="@Active("Branches")" asp-area="Admin" asp-controller="Branches" asp-action="Index"><i class="bi bi-buildings"></i>Şubeler</a>
                    <a class="@Active("Extras")" asp-area="Admin" asp-controller="Extras" asp-action="Index"><i class="bi bi-plus-square"></i>Ek Hizmetler</a>
                    @if (isAdmin)
                    {
                        <a class="@Active("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge"></i>Personel & Roller</a>
                    }
                </nav>

                <div class="user-area d-flex align-items-center gap-2">
                    <span class="avatar">@(User.Identity?.Name?[..1].ToUpperInvariant())</span>
                    <div class="min-w-0 flex-grow-1">
                        <div class="small fw-semibold text-truncate">@User.Identity?.Name</div>
                        <div class="small text-muted">@(isAdmin ? "Yönetici" : "Personel")</div>
                    </div>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn btn-ghost btn-icon btn-sm" title="Çıkış yap" aria-label="Çıkış yap"><i class="bi bi-box-arrow-right"></i></button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="btn btn-ghost btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-label="Menüyü aç">
                    <i class="bi bi-list"></i>
                </button>
                <form asp-area="Admin" asp-controller="Reservations" asp-action="Index" method="get" class="flex-grow-1" style="max-width:420px">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="search" name="Q" class="form-control" placeholder="Rezervasyon kodu, plaka veya müşteri ara…" aria-label="Ara" />
                    </div>
                </form>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="Temayı değiştir"><i class="bi bi-moon-stars"></i></button>
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-ghost d-none d-sm-inline-flex" target="_blank"><i class="bi bi-box-arrow-up-right me-2"></i>Siteyi aç</a>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_Toast" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
