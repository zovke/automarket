@model ProfileViewModel
@{
    ViewData["Title"] = "Profil ve Ehliyet";
}
<div class="container py-4" style="max-width: 820px">
    <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Rezervasyonlarım</a>
    <h1 class="h3 mt-2 mb-4">Profil ve ehliyet bilgileri</h1>

    <form asp-action="Edit" method="post" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-person me-2 text-brand"></i>Kişisel bilgiler</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TcNo" class="form-label"></label>
                    <input asp-for="TcNo" class="form-control" inputmode="numeric" maxlength="11" />
                    <span asp-validation-for="TcNo"></span>
                    <div class="form-text">11 haneli numara, resmi algoritma ile doğrulanır.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="BirthDate" class="form-label"></label>
                    <input asp-for="BirthDate" type="date" class="form-control" />
                    <span asp-validation-for="BirthDate"></span>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><i class="bi bi-person-vcard me-2 text-brand"></i>Ehliyet</div>
            <div class="card-body row g-3">
                <div class="col-md-6">
                    <label asp-for="LicenseNumber" class="form-label"></label>
                    <input asp-for="LicenseNumber" class="form-control" />
                    <span asp-validation-for="LicenseNumber"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LicenseIssueDate" class="form-label"></label>
                    <input asp-for="LicenseIssueDate" type="date" class="form-control" />
                    <span asp-validation-for="LicenseIssueDate"></span>
                </div>
                <div class="col-12">
                    <div class="card-soft p-3 small text-muted">
                        <i class="bi bi-info-circle me-1"></i>Her aracın minimum sürücü yaşı ve ehliyet süresi şartı vardır
                        (ör. lüks araçlarda 27 yaş / 5 yıl). Rezervasyon sırasında bu bilgiler otomatik kontrol edilir.
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i>Kaydet</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
