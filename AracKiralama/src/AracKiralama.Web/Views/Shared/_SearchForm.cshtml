@* Şube + tarih arama formu (ana sayfa ve araç listesi). Sonuçlar /Vehicles sayfasında listelenir. *@
@model (VehicleFilter Filter, List<Branch> Branches)
@{
    var start = Model.Filter.Start ?? DateTime.Today.AddDays(1).AddHours(10);
    var end = Model.Filter.End ?? start.AddDays(3);
}
<form asp-controller="Vehicles" asp-action="Index" method="get" class="row g-3 align-items-end" data-date-pair>
    <div class="col-12 col-md-6 col-lg-3">
        <label class="form-label" for="s-pickup"><i class="bi bi-geo-alt me-1"></i>Alış şubesi</label>
        <select class="form-select" id="s-pickup" name="PickupBranchId">
            <option value="">Tüm şubeler</option>
            @foreach (var b in Model.Branches)
            {
                <option value="@b.Id" selected="@(Model.Filter.PickupBranchId == b.Id)">@b.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <label class="form-label" for="s-return"><i class="bi bi-geo me-1"></i>İade şubesi</label>
        <select class="form-select" id="s-return" name="ReturnBranchId">
            <option value="">Alış şubesiyle aynı</option>
            @foreach (var b in Model.Branches)
            {
                <option value="@b.Id" selected="@(Model.Filter.ReturnBranchId == b.Id)">@b.Name</option>
            }
        </select>
    </div>
    <div class="col-12 col-sm-6 col-lg-2">
        <label class="form-label" for="s-start"><i class="bi bi-calendar-event me-1"></i>Alış</label>
        <input class="form-control" type="datetime-local" id="s-start" name="Start" value="@Fmt.Input(start)" min="@Fmt.Input(DateTime.Today)" data-date-start />
    </div>
    <div class="col-12 col-sm-6 col-lg-2">
        <label class="form-label" for="s-end"><i class="bi bi-calendar-check me-1"></i>İade</label>
        <input class="form-control" type="datetime-local" id="s-end" name="End" value="@Fmt.Input(end)" data-date-end />
    </div>
    <div class="col-12 col-lg-2 d-grid">
        <button class="btn btn-primary btn-lg text-nowrap" type="submit"><i class="bi bi-search me-2"></i>Araç Bul</button>
    </div>
</form>
