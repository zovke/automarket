@model ReportsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Raporlar";
    var r = Model.Report;
    var from = Model.From.ToString("yyyy-MM-dd");
    var to = Model.To.ToString("yyyy-MM-dd");
}
<div class="page-head">
    <div><h1>Raporlar</h1><div class="sub">@Fmt.Date(Model.From) – @Fmt.Date(Model.To)</div></div>
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="date" name="from" value="@from" class="form-control" style="width:auto" aria-label="Başlangıç" />
        <input type="date" name="to" value="@to" class="form-control" style="width:auto" aria-label="Bitiş" />
        <button class="btn btn-ghost">Uygula</button>
        <a asp-action="Excel" asp-route-from="@from" asp-route-to="@to" class="btn btn-primary"><i class="bi bi-file-earmark-excel me-1"></i>Excel'e aktar</a>
    </form>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    @foreach (var (label, days) in new[] { ("Son 7 gün", 6), ("Son 30 gün", 29), ("Son 90 gün", 89), ("Son 1 yıl", 364) })
    {
        <a class="chip" asp-route-from="@DateTime.Today.AddDays(-days).ToString("yyyy-MM-dd")" asp-route-to="@DateTime.Today.ToString("yyyy-MM-dd")">@label</a>
    }
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-sm-6 col-xl-3">@await Html.PartialAsync("_KpiCard", new KpiModel("Gelir", Fmt.Money(r.TotalRevenue), "bi-cash-stack", "brand"))</div>
    <div class="col-12 col-sm-6 col-xl-3">@await Html.PartialAsync("_KpiCard", new KpiModel("Tamamlanan kiralama", r.RentalCount.ToString(), "bi-journal-check", "success"))</div>
    <div class="col-12 col-sm-6 col-xl-3">@await Html.PartialAsync("_KpiCard", new KpiModel("Ortalama kiralama", Fmt.Money(r.AverageRental), "bi-receipt", "info"))</div>
    <div class="col-12 col-sm-6 col-xl-3">@await Html.PartialAsync("_KpiCard", new KpiModel("Ort. kullanım oranı", $"%{r.AverageUtilization * 100:0}", "bi-speedometer2", "warning", $"{r.RentedDays} araç-gün kirada"))</div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card table-card">
            <div class="card-header">Araç bazlı performans</div>
            <div class="table-responsive" style="max-height:560px">
                <table class="table table-hover align-middle">
                    <thead class="sticky-top"><tr><th>Araç</th><th>Kategori</th><th class="text-end">Kiralama</th><th class="text-end">Gün</th><th style="min-width:160px">Kullanım</th><th class="text-end">Gelir</th></tr></thead>
                    <tbody>
                        @foreach (var v in r.Vehicles)
                        {
                            <tr>
                                <td><a asp-controller="Vehicles" asp-action="Details" asp-route-id="@v.VehicleId" class="fw-semibold text-reset">@v.Name</a><div><span class="kbd-plate">@v.Plate</span></div></td>
                                <td class="small">@v.Category</td>
                                <td class="text-end tabular">@v.RentalCount</td>
                                <td class="text-end tabular">@v.RentedDays</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1"><div class="progress-bar" style="width:@((v.Utilization * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                                        <span class="small tabular text-muted" style="width:38px">%@((v.Utilization * 100).ToString("0"))</span>
                                    </div>
                                </td>
                                <td class="text-end tabular fw-semibold">@Fmt.Money(v.Revenue)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header">Şubelere göre gelir</div>
            <div class="card-body"><div class="chart-box" style="height:240px"><canvas id="branchChart"></canvas></div></div>
        </div>
        <div class="card table-card">
            <ul class="mini-list">
                @foreach (var b in r.Branches)
                {
                    <li><div class="flex-grow-1"><div class="fw-semibold small">@b.Branch</div><div class="meta">@b.RentalCount kiralama</div></div><span class="tabular fw-semibold small">@Fmt.Money(b.Revenue)</span></li>
                }
            </ul>
            @if (r.Branches.Count == 0) { <div class="card-body small text-muted">Bu aralıkta veri yok.</div> }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const branches = @Html.Raw(JsonSerializer.Serialize(r.Branches));
        let chart;
        function draw() {
            chart?.destroy();
            const s = getComputedStyle(document.documentElement);
            Chart.defaults.color = s.getPropertyValue("--muted").trim();
            Chart.defaults.font.family = "Inter, system-ui, sans-serif";
            chart = new Chart(document.getElementById("branchChart"), {
                type: "bar",
                data: { labels: branches.map(b => b.Branch), datasets: [{ data: branches.map(b => b.Revenue), backgroundColor: s.getPropertyValue("--brand").trim(), borderRadius: 6 }] },
                options: {
                    indexAxis: "y", maintainAspectRatio: false,
                    plugins: { legend: { display: false }, tooltip: { callbacks: { label: c => new Intl.NumberFormat("tr-TR").format(c.raw) + " ₺" } } },
                    scales: { x: { grid: { color: s.getPropertyValue("--border").trim() }, ticks: { callback: v => (v / 1000) + "K" } }, y: { grid: { display: false } } }
                }
            });
        }
        draw();
        document.addEventListener("themechange", draw);
    </script>
}
