@model HomeViewModel
@{
    ViewData["Title"] = "Araç Kiralama";
}

<section class="hero">
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="hero-badge mb-4"><span class="dot"></span> @Model.Branches.Count şubede @Model.VehicleCount araç hazır</span>
                <h1 class="mb-4">Yolculuğun nereye olursa olsun, <span style="color:#a5b4ff">doğru araç</span> seni bekliyor.</h1>
                <p class="lead mb-0">Tarihini seç, aracını karşılaştır, dakikalar içinde rezervasyonunu yap. Gizli ücret yok, fiyatın tamamını en baştan görürsün.</p>
                <div class="hero-stats">
                    <div><strong>@Model.VehicleCount+</strong><span>Araç</span></div>
                    <div><strong>@Fmt.Number(Model.CompletedRentals)</strong><span>Tamamlanan kiralama</span></div>
                    <div><strong>7/24</strong><span>Yol yardımı</span></div>
                </div>
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="hero-car">
                    <img src="~/img/cars/Audi_A7.jpg" alt="Audi A7" />
                    <div class="floating" style="left:-28px; bottom:42px">
                        <i class="bi bi-shield-check text-success"></i>
                        <div><b>Tam kasko</b><div class="text-muted small">Tek tıkla ekle</div></div>
                    </div>
                    <div class="floating" style="right:-18px; top:28px">
                        <i class="bi bi-lightning-charge-fill text-warning"></i>
                        <div><b>Anında fiyat</b><div class="text-muted small">Sürpriz ücret yok</div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="search-card">
        <partial name="_SearchForm" model="(new VehicleFilter(), Model.Branches)" />
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <div class="section-eyebrow mb-2">Kategoriler</div>
                <h2 class="section-title mb-0">İhtiyacına uygun sınıfı seç</h2>
            </div>
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-ghost">Tüm araçlar <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
        <div class="row g-3">
            @foreach (var c in Model.Categories)
            {
                <div class="col-6 col-md-4 col-xl">
                    <a class="category-card" asp-controller="Vehicles" asp-action="Index" asp-route-Category="@c.Category">
                        <img src="@c.ImageUrl" alt="@c.Category.GetDisplayName()" loading="lazy" />
                        <div class="content">
                            <h3>@c.Category.GetDisplayName()</h3>
                            <div class="small opacity-75">@c.Count araç</div>
                            <div class="small fw-semibold">Günlük @Fmt.Money(c.MinPrice)'den</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="mb-4">
            <div class="section-eyebrow mb-2">Öne çıkanlar</div>
            <h2 class="section-title mb-0">Her bütçeye uygun seçenekler</h2>
        </div>
        <div class="row g-4">
            @foreach (var v in Model.Featured)
            {
                <div class="col-sm-6 col-lg-3">
                    <partial name="_VehicleCard" model="new VehicleCardViewModel { Vehicle = v }" />
                </div>
            }
        </div>
    </div>
</section>

<section class="section pt-0">
    <div class="container">
        <div class="card p-3 p-md-4">
            <div class="row g-3 text-center text-md-start">
                <div class="col-md-4">
                    <div class="step-card">
                        <span class="ico"><i class="bi bi-calendar2-range"></i></span>
                        <h3 class="h5">1. Tarih ve şube seç</h3>
                        <p class="text-muted mb-0">Alış ve iade noktanı belirle; farklı şubeye iade de mümkün.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="step-card">
                        <span class="ico"><i class="bi bi-ui-checks-grid"></i></span>
                        <h3 class="h5">2. Aracını ve ekstralarını belirle</h3>
                        <p class="text-muted mb-0">Sadece o tarihlerde müsait araçlar listelenir, fiyat anında hesaplanır.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="step-card">
                        <span class="ico"><i class="bi bi-key"></i></span>
                        <h3 class="h5">3. Onayı al, anahtarını teslim al</h3>
                        <p class="text-muted mb-0">Talebin onaylandığında sözleşmen hazır; şubeden aracını al ve yola çık.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section pt-0" id="subeler">
    <div class="container">
        <div class="mb-4">
            <div class="section-eyebrow mb-2">Şubelerimiz</div>
            <h2 class="section-title mb-0">Havalimanında ve şehir merkezinde</h2>
        </div>
        <div class="row g-3">
            @foreach (var b in Model.Branches)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body d-flex gap-3">
                            <span class="kpi p-0"><span class="ico ico-brand"><i class="bi bi-buildings"></i></span></span>
                            <div class="min-w-0">
                                <div class="small-caps">@b.City</div>
                                <h3 class="h6 mb-1">@b.Name</h3>
                                <div class="small text-muted mb-2">@b.Address</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="chip"><i class="bi bi-telephone"></i>@b.Phone</span>
                                    <a class="chip" asp-controller="Vehicles" asp-action="Index" asp-route-PickupBranchId="@b.Id">Araçları gör <i class="bi bi-arrow-right"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
