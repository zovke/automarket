@model Vehicle
@{
    var v = Model;
    ViewData["Title"] = v.DisplayName;
    var revenue = (decimal)ViewBag.Revenue;
    var rentalCount = (int)ViewBag.RentalCount;
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Araçlar</a>
        <h1 class="d-flex align-items-center gap-2 mt-1">@v.DisplayName <partial name="_VehicleStatusBadge" model="v.Status" /></h1>
        <div class="sub"><span class="kbd-plate">@v.Plate</span> · @v.Branch!.Name</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Maintenance" asp-action="Create" asp-route-vehicleId="@v.Id" class="btn btn-ghost"><i class="bi bi-tools me-1"></i>Bakım kaydı</a>
        <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Düzenle</a>
        <form asp-action="Delete" asp-route-id="@v.Id" method="post">
            <button class="btn btn-ghost text-danger" data-confirm="Araç silinsin mi? Kiralama geçmişi varsa silinmez, pasife alınır.">Sil / Pasife al</button>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-5">
        <div class="detail-media"><img src="@(v.ImageUrl ?? "/img/placeholder.svg")" alt="@v.DisplayName" /></div>
    </div>
    <div class="col-lg-7">
        <div class="row g-3">
            <div class="col-sm-6 col-md-4">@await Html.PartialAsync("_KpiCard", new KpiModel("Toplam gelir", Fmt.Money(revenue), "bi-cash-stack", "brand"))</div>
            <div class="col-sm-6 col-md-4">@await Html.PartialAsync("_KpiCard", new KpiModel("Kiralama", rentalCount.ToString(), "bi-journal-check", "info"))</div>
            <div class="col-12 col-md-4">@await Html.PartialAsync("_KpiCard", new KpiModel("Kilometre", Fmt.Number(v.Kilometers), "bi-speedometer", "warning"))</div>
            <div class="col-12">
                <div class="card">
                    <div class="card-body row g-3 small">
                        <div class="col-6 col-md-3"><div class="small-caps">Kategori</div>@v.Category.GetDisplayName()</div>
                        <div class="col-6 col-md-3"><div class="small-caps">Model yılı</div>@v.Year</div>
                        <div class="col-6 col-md-3"><div class="small-caps">Vites / Yakıt</div>@v.Transmission.GetDisplayName() / @v.Fuel.GetDisplayName()</div>
                        <div class="col-6 col-md-3"><div class="small-caps">Koltuk / Renk</div>@v.Seats / @v.Color</div>
                        <div class="col-6 col-md-3"><div class="small-caps">Günlük</div><b>@Fmt.Money(v.DailyPrice)</b></div>
                        <div class="col-6 col-md-3"><div class="small-caps">Depozito</div>@Fmt.Money(v.Deposit)</div>
                        <div class="col-6 col-md-3"><div class="small-caps">Min. yaş</div>@v.MinDriverAge</div>
                        <div class="col-6 col-md-3"><div class="small-caps">Min. ehliyet</div>@v.MinLicenseYears yıl</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-xl-8">
        <div class="card table-card">
            <div class="card-header">Son kiralamalar</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Kod</th><th>Müşteri</th><th>Tarih</th><th>Durum</th><th class="text-end">Tutar</th></tr></thead>
                    <tbody>
                        @foreach (var r in v.Reservations)
                        {
                            <tr>
                                <td><a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="tabular">@r.Code</a></td>
                                <td>@r.Customer!.FullName</td>
                                <td class="small text-muted">@Fmt.Date(r.StartDate) – @Fmt.Date(r.EndDate)</td>
                                <td><partial name="_StatusBadge" model="r" /></td>
                                <td class="text-end tabular">@Fmt.Money(r.TotalPrice)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (v.Reservations.Count == 0) { <div class="empty-state py-4">Henüz kiralama yok.</div> }
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">Bakım geçmişi</div>
            <ul class="mini-list">
                @foreach (var m in v.Maintenances)
                {
                    <li>
                        <span class="kpi p-0"><span class="ico @(m.IsCompleted ? "ico-success" : "ico-warning")" style="width:34px;height:34px;font-size:1rem"><i class="bi bi-tools"></i></span></span>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@m.Type.GetDisplayName()</div>
                            <div class="meta">@Fmt.Date(m.StartDate) · @Fmt.Number(m.Kilometers) km</div>
                        </div>
                        <span class="small tabular">@Fmt.Money(m.Cost)</span>
                    </li>
                }
            </ul>
            @if (v.Maintenances.Count == 0) { <div class="card-body small text-muted">Bakım kaydı yok.</div> }
        </div>
    </div>
</div>
