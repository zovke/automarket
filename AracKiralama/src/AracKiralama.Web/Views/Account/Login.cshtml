@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}
<div class="auth-wrap">
    <div class="auth-side">
        <h2 class="mb-2">Tekrar hoş geldiniz.</h2>
        <p class="opacity-75 mb-0">Rezervasyonlarınızı takip edin, sözleşmenizi indirin, bir sonraki yolculuğunuzu planlayın.</p>
    </div>
    <div class="auth-form">
        <div class="inner">
            <h1 class="h3 mb-1">Giriş yap</h1>
            <p class="text-muted mb-4">Hesabınız yok mu? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Hemen üye olun</a></p>

            <form asp-action="Login" method="post" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button class="btn btn-primary btn-lg w-100" type="submit">Giriş Yap</button>
            </form>

            @* Sunum kolaylığı: demo hesapların e-postasını tek tıkla doldurur. Şifreler README'de. *@
            <div class="card-soft p-3 mt-4 demo-accounts">
                <div class="fw-semibold mb-2"><i class="bi bi-info-circle me-1"></i>Demo hesaplar (şifre: README)</div>
                <div class="d-grid gap-1">
                    <button type="button" class="btn btn-sm btn-ghost" data-demo="admin@rota.com"><b>Admin</b> · admin@rota.com</button>
                    <button type="button" class="btn btn-sm btn-ghost" data-demo="personel@rota.com"><b>Personel</b> · personel@rota.com</button>
                    <button type="button" class="btn btn-sm btn-ghost" data-demo="musteri@rota.com"><b>Müşteri</b> · musteri@rota.com</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll("[data-demo]").forEach(b => b.addEventListener("click", () => {
            document.getElementById("Email").value = b.dataset.demo;
            document.getElementById("Password").focus();
        }));
    </script>
}
