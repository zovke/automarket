@model Branch
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Şubeyi düzenle" : "Yeni şube";
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Şubeler</a>
        <h1 class="mt-1">@ViewData["Title"]</h1>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" class="card" style="max-width:720px" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="card-body row g-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City"></span>
        </div>
        <div class="col-12">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone"></span>
        </div>
    </div>
    <div class="card-body border-top d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
        <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Kaydet</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
