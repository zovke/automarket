@model List<UserRow>
@{
    ViewData["Title"] = "Personel & Roller";
}
<div class="page-head">
    <div><h1>Personel & Roller</h1><div class="sub">Yönetim paneline erişebilen hesaplar</div></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Personel ekle</a>
</div>

<div class="card-soft p-3 small mb-3">
    <b>Admin</b>: her şeye erişir, personel ekler. <b>Personel</b>: rezervasyon, araç, müşteri ve raporları yönetir; bu sayfayı göremez.
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Rol</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td class="fw-semibold">@row.User.FullName</td>
                        <td>@row.User.Email</td>
                        <td><span class="status @(row.Role == Roles.Admin ? "status-approved" : "status-active")">@row.Role</span></td>
                        <td class="text-end">
                            <form asp-action="ToggleRole" asp-route-id="@row.User.Id" method="post">
                                <button class="btn btn-sm btn-ghost" data-confirm="Rol değiştirilsin mi?">@(row.Role == Roles.Admin ? "Personel yap" : "Admin yap")</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
