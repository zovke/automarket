@* Sayfalama. Model: (toplam sayfa, mevcut sayfa, sayfa linki üreten fonksiyon) *@
@model (int TotalPages, int Page, Func<int, string> Url)
@if (Model.TotalPages > 1)
{
    var from = Math.Max(1, Model.Page - 2);
    var to = Math.Min(Model.TotalPages, Model.Page + 2);
    <nav aria-label="Sayfalar" class="mt-4">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link" href="@Model.Url(Model.Page - 1)" aria-label="Önceki"><i class="bi bi-chevron-left"></i></a>
            </li>
            @if (from > 1)
            {
                <li class="page-item"><a class="page-link" href="@Model.Url(1)">1</a></li>
                if (from > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> }
            }
            @for (var i = from; i <= to; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Model.Url(i)">@i</a></li>
            }
            @if (to < Model.TotalPages)
            {
                if (to < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> }
                <li class="page-item"><a class="page-link" href="@Model.Url(Model.TotalPages)">@Model.TotalPages</a></li>
            }
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Model.Url(Model.Page + 1)" aria-label="Sonraki"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
}
