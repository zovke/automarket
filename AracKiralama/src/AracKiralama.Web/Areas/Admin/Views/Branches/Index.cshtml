@model List<Branch>
@{
    ViewData["Title"] = "Şubeler";
    var counts = (Dictionary<int, int>)ViewBag.VehicleCounts;
}
<div class="page-head">
    <div><h1>Şubeler</h1><div class="sub">Araç alma ve iade noktaları</div></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni şube</a>
</div>

<div class="row g-3">
    @foreach (var b in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small-caps">@b.City</div>
                            <h2 class="h6 mb-1">@b.Name</h2>
                        </div>
                        <span class="chip"><i class="bi bi-car-front"></i>@counts.GetValueOrDefault(b.Id) araç</span>
                    </div>
                    <div class="small text-muted mb-1"><i class="bi bi-geo-alt me-1"></i>@b.Address</div>
                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@b.Phone</div>
                </div>
                <div class="card-body border-top d-flex gap-2 py-2">
                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-ghost"><i class="bi bi-pencil me-1"></i>Düzenle</a>
                    <a asp-controller="Vehicles" asp-action="Index" asp-route-branchId="@b.Id" class="btn btn-sm btn-ghost">Araçlar</a>
                    <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="ms-auto">
                        <button class="btn btn-sm btn-ghost text-danger" data-confirm="@b.Name şubesi silinsin mi?" aria-label="Sil"><i class="bi bi-trash"></i></button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
