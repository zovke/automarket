@model int
@{
    var (title, text, icon) = Model switch
    {
        404 => ("Sayfa bulunamadı", "Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.", "bi-signpost-2"),
        403 => ("Erişim engellendi", "Bu sayfayı görüntüleme yetkiniz yok.", "bi-shield-lock"),
        _ => ("Bir şeyler ters gitti", "Beklenmeyen bir durum oluştu.", "bi-exclamation-octagon"),
    };
    ViewData["Title"] = title;
}
<div class="container py-5">
    <div class="empty-state">
        <i class="bi @icon"></i>
        <div class="display-4 fw-bold text-body">@Model</div>
        <h1 class="h4 text-body">@title</h1>
        <p>@text</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
    </div>
</div>
