@model Extra
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Hizmeti düzenle" : "Yeni ek hizmet";
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Ek Hizmetler</a>
        <h1 class="mt-1">@ViewData["Title"]</h1>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.Id : null)" method="post" class="card" style="max-width:720px" novalidate>
    <input type="hidden" asp-for="Id" />
    <div class="card-body row g-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DailyPrice" class="form-label"></label>
            <input asp-for="DailyPrice" class="form-control" step="10" />
            <span asp-validation-for="DailyPrice"></span>
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Icon" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i id="iconPreview" class="bi @Model.Icon"></i></span>
                <input asp-for="Icon" class="form-control" placeholder="bi-shield-check" data-icon-preview="#iconPreview" />
            </div>
            <div class="form-text">İkon adları: <a href="https://icons.getbootstrap.com" target="_blank" rel="noopener">icons.getbootstrap.com</a></div>
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <div class="card-body border-top d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
        <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Kaydet</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
