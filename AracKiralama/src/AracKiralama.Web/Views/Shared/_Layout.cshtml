@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => controller == c && (a is null || action == a) ? "active" : "";
    var isStaff = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Staff);
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <partial name="_Head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <header class="site-nav">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-signpost-split-fill"></i></span>
                    @Site.Value.Name <small>@Site.Value.Tagline</small>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menüyü aç">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto gap-lg-1 mt-3 mt-lg-0">
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Vehicles")" asp-controller="Vehicles" asp-action="Index">Araçlar</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")#subeler">Şubeler</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Home", "About")" asp-controller="Home" asp-action="About">Hakkımızda</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Home", "Contact")" asp-controller="Home" asp-action="Contact">İletişim</a></li>
                    </ul>

                    <div class="d-flex align-items-center gap-2 pb-3 pb-lg-0">
                        <button class="btn btn-ghost btn-icon" type="button" data-theme-toggle aria-label="Temayı değiştir" title="Açık / koyu tema">
                            <i class="bi bi-moon-stars"></i>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-ghost d-flex align-items-center gap-2 py-1 ps-1 pe-3" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar">@(User.Identity.Name?[..1].ToUpperInvariant())</span>
                                    <span class="d-none d-sm-inline small">Hesabım</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="px-3 py-2 small text-muted">@User.Identity.Name</li>
                                    @if (isStaff)
                                    {
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Yönetim Paneli</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-calendar2-check"></i> Rezervasyonlarım</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Edit"><i class="bi bi-person"></i> Profil ve Ehliyet</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right text-danger"></i> Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">Üye Ol</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <partial name="_Footer" />
    <partial name="_Toast" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
