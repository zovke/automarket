@model List<CustomerRow>
@{
    ViewData["Title"] = "Müşteriler";
    var q = (string?)ViewBag.Q;
    var blacklisted = (bool)ViewBag.Blacklisted;
}

<div class="page-head">
    <div>
        <h1>Müşteriler</h1>
        <div class="sub">@Model.Count müşteri · harcamaya göre sıralı</div>
    </div>
</div>

<div class="card table-card">
    <form method="get" class="card-header d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group" style="max-width:340px">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="q" value="@q" class="form-control" placeholder="Ad, e-posta veya telefon" />
        </div>
        <div class="form-check form-switch ms-2">
            <input class="form-check-input" type="checkbox" role="switch" id="bl" name="blacklisted" value="true" checked="@blacklisted" onchange="this.form.requestSubmit()" />
            <label class="form-check-label small" for="bl">Sadece kara liste</label>
        </div>
        <button class="btn btn-ghost">Ara</button>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Müşteri</th><th>Telefon</th><th>Ehliyet</th><th class="text-end">Kiralama</th><th class="text-end">Toplam harcama</th><th>Son kiralama</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var u = row.User;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="avatar">@u.FirstName[..1]@u.LastName[..1]</span>
                                <div>
                                    <a asp-action="Details" asp-route-id="@u.Id" class="fw-semibold text-reset">@u.FullName</a>
                                    @if (u.IsBlacklisted) { <span class="status status-rejected ms-1">Kara liste</span> }
                                    <div class="small text-muted">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="small">@(u.PhoneNumber ?? "-")</td>
                        <td class="small">
                            @if (u.LicenseIssueDate is { } l) { <span>@ReservationService.YearsBetween(l, DateTime.Today) yıllık</span> }
                            else { <span class="text-warning">Eksik</span> }
                        </td>
                        <td class="text-end tabular">@row.RentalCount</td>
                        <td class="text-end tabular fw-semibold">@Fmt.Money(row.TotalSpent)</td>
                        <td class="small text-muted">@(row.LastRental is { } d ? Fmt.Date(d) : "-")</td>
                        <td class="text-end"><a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-ghost" aria-label="Detay"><i class="bi bi-chevron-right"></i></a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Count == 0) { <div class="empty-state"><i class="bi bi-people"></i>Müşteri bulunamadı.</div> }
</div>
