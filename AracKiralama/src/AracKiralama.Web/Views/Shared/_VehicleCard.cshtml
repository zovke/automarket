@* Araç kartı. Ana sayfa, araç listesi ve "benzer araçlar" bölümünde aynı kart kullanılır. *@
@model VehicleCardViewModel
@{
    var v = Model.Vehicle;
    var route = Model.Search?.ToSearchRouteValues() ?? new Dictionary<string, string>();
    route["id"] = v.Id.ToString();
}
<article class="vehicle-card">
    <a asp-controller="Vehicles" asp-action="Details" asp-all-route-data="route" class="media d-block">
        <img src="@(v.ImageUrl ?? "/img/placeholder.svg")" alt="@v.DisplayName" loading="lazy" />
        <span class="chip chip-glass badge-cat">@v.Category.GetDisplayName()</span>
    </a>
    <div class="body">
        <div>
            <div class="d-flex justify-content-between align-items-start gap-2">
                <h3 class="title">
                    <a asp-controller="Vehicles" asp-action="Details" asp-all-route-data="route" class="text-reset">@v.DisplayName</a>
                </h3>
                <span class="small text-muted">@v.Year</span>
            </div>
            <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@v.Branch?.Name</div>
        </div>
        <div class="specs">
            <span><i class="bi bi-gear-wide-connected"></i>@v.Transmission.GetDisplayName()</span>
            <span><i class="bi bi-fuel-pump"></i>@v.Fuel.GetDisplayName()</span>
            <span><i class="bi bi-people"></i>@v.Seats kişi</span>
        </div>
        <div class="footer">
            <div>
                @if (Model.Days is int days)
                {
                    <div class="small text-muted text-nowrap">@days gün · ≈@Fmt.Money(v.DailyPrice * days)</div>
                }
                <div class="price">@Fmt.Money(v.DailyPrice) <small>/ gün</small></div>
            </div>
            <a asp-controller="Vehicles" asp-action="Details" asp-all-route-data="route" class="btn btn-soft btn-sm text-nowrap">
                İncele <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</article>
