@model ReturnViewModel
@inject IOptions<PricingOptions> Pricing
@{
    var r = Model.Reservation!;
    ViewData["Title"] = "İade";
}
<div class="page-head">
    <div>
        <a asp-action="Details" asp-route-id="@r.Id" class="small"><i class="bi bi-arrow-left me-1"></i>@r.Code</a>
        <h1 class="mt-1">İade al</h1>
        <div class="sub">@r.Customer!.FullName · @r.Vehicle!.DisplayName <span class="kbd-plate">@r.Vehicle.Plate</span></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <form asp-action="Return" method="post" class="card">
            <input type="hidden" asp-for="ReservationId" />
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ReturnedAt" class="form-label"></label>
                        <input asp-for="ReturnedAt" type="datetime-local" class="form-control" value="@Fmt.Input(Model.ReturnedAt)" />
                        <div class="form-text">Planlanan: @Fmt.DateTime(r.EndDate)</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndKm" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="EndKm" class="form-control" />
                            <span class="input-group-text">km</span>
                        </div>
                        <span asp-validation-for="EndKm"></span>
                        <div class="form-text">Teslimde: @Fmt.Number(r.StartKm ?? 0) km</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FuelLevelIn" class="form-label"></label>
                        <select asp-for="FuelLevelIn" class="form-select" asp-items="Html.GetEnumSelectList<FuelLevel>()"></select>
                        <div class="form-text">Teslimde: @r.FuelLevelOut?.GetDisplayName() · eksik her 1/4 depo @Fmt.Money(Pricing.Value.FuelFeePerQuarter)</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DamageCost" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="DamageCost" class="form-control" step="0.01" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="DamageCost"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DamageDescription" class="form-label"></label>
                        <input asp-for="DamageDescription" class="form-control" placeholder="Hasar yoksa boş bırakın" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-body border-top d-flex justify-content-end gap-2">
                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-ghost">Vazgeç</a>
                <button class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>İadeyi tamamla</button>
            </div>
        </form>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">Otomatik hesaplanacak ücretler</div>
            <div class="card-body">
                <ul class="breakdown">
                    <li><span>Mevcut toplam</span><span>@Fmt.Money(r.TotalPrice)</span></li>
                    <li><span>Geç iade (şu an iade edilirse)</span><span class="@(Model.EstimatedLateFee > 0 ? "text-danger fw-semibold" : "")">@Fmt.Money(Model.EstimatedLateFee)</span></li>
                    <li><span>Eksik yakıt</span><span class="text-muted">formdaki seviyeye göre</span></li>
                    <li><span>Hasar</span><span class="text-muted">girilen tutar</span></li>
                </ul>
                <div class="card-soft p-3 small text-muted mt-3">
                    <i class="bi bi-info-circle me-1"></i>Planlanan iade saatinden @Pricing.Value.LateGraceMinutes dakika sonra başlayan her gün için
                    günlük ücretin @Pricing.Value.LateFeeMultiplier.ToString("0.#", Fmt.Tr) katı eklenir. Hesap <code>PricingService.CalculateLateFee</code> içinde.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
