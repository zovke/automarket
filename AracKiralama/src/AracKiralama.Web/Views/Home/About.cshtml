@{
    ViewData["Title"] = "Hakkımızda";
}
<div class="container py-5">
    <div class="row g-5 align-items-center">
        <div class="col-lg-6">
            <div class="section-eyebrow mb-2">Hakkımızda</div>
            <h1 class="section-title mb-3">Araç kiralamayı basit, şeffaf ve hızlı hale getiriyoruz.</h1>
            <p class="text-muted">@Site.Value.Name, Türkiye'nin önemli havalimanlarında ve şehir merkezlerinde hizmet veren bir araç kiralama markasıdır. Ekonomik sınıftan lüks segmente, ticari araçlardan 9 kişilik minibüslere kadar geniş bir filoyla bireysel ve kurumsal müşterilerimize hizmet veriyoruz.</p>
            <p class="text-muted">Bütün fiyatlarımız rezervasyon anında kalem kalem gösterilir; teslimde sürpriz ücretle karşılaşmazsınız. Rezervasyondan iadeye kadar her adım dijital olarak takip edilir.</p>
            <div class="row g-3 mt-2">
                <div class="col-4"><div class="h3 mb-0 text-brand">5</div><div class="small text-muted">Şube</div></div>
                <div class="col-4"><div class="h3 mb-0 text-brand">5</div><div class="small text-muted">Araç sınıfı</div></div>
                <div class="col-4"><div class="h3 mb-0 text-brand">7/24</div><div class="small text-muted">Yol yardımı</div></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="detail-media"><img src="~/img/cars/Volkswagen_Tiguan.jpg" alt="Volkswagen Tiguan" /></div>
        </div>
    </div>

    <div class="row g-3 mt-5">
        @foreach (var (icon, title, text) in new[] {
            ("bi-cash-coin", "Şeffaf fiyat", "Gün sayısı, indirim, ekstra ve tek yön ücreti en baştan gösterilir."),
            ("bi-shield-check", "Güvenli kiralama", "Tüm araçlarımız periyodik bakımlı ve kasko kapsamındadır."),
            ("bi-arrow-repeat", "Esnek iade", "Farklı bir şubeye iade edebilir, 24 saat öncesine kadar ücretsiz iptal edebilirsiniz."),
            ("bi-headset", "Kesintisiz destek", "Yolculuğunuz boyunca 7/24 çağrı merkezi ve yol yardımı.") })
        {
            <div class="col-md-6 col-lg-3">
                <div class="card step-card">
                    <span class="ico"><i class="bi @icon"></i></span>
                    <h2 class="h6">@title</h2>
                    <p class="small text-muted mb-0">@text</p>
                </div>
            </div>
        }
    </div>
</div>
