@model AdminReservationListViewModel
@{
    ViewData["Title"] = "Rezervasyonlar";
    var f = Model.Filter;
    var total = Model.StatusCounts.Values.Sum();
    string Link(ReservationStatus? s) => Url.Action("Index", new { Status = s, f.Q, f.BranchId })!;
}

<div class="page-head">
    <div>
        <h1>Rezervasyonlar</h1>
        <div class="sub">Talepleri onaylayın, teslim ve iade işlemlerini yönetin.</div>
    </div>
</div>

<ul class="nav nav-pills gap-1 mb-3 flex-nowrap overflow-auto pb-1">
    <li class="nav-item"><a class="nav-link @(f.Status is null && !f.OverdueOnly ? "active" : "")" href="@Link(null)">Tümü <span class="opacity-75">@total</span></a></li>
    @foreach (var s in Enum.GetValues<ReservationStatus>())
    {
        <li class="nav-item">
            <a class="nav-link text-nowrap @(f.Status == s ? "active" : "")" href="@Link(s)">@s.GetDisplayName() <span class="opacity-75">@Model.StatusCounts.GetValueOrDefault(s)</span></a>
        </li>
    }
    <li class="nav-item"><a class="nav-link text-nowrap @(f.OverdueOnly ? "active" : "")" asp-route-OverdueOnly="true"><i class="bi bi-alarm"></i> Gecikmiş</a></li>
</ul>

<div class="card table-card">
    <form method="get" class="card-header d-flex flex-wrap gap-2 align-items-center">
        <input type="hidden" name="Status" value="@f.Status" />
        <div class="input-group" style="max-width:340px">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="Q" value="@f.Q" class="form-control" placeholder="Kod, plaka, müşteri adı / e-posta" />
        </div>
        <select name="BranchId" class="form-select" style="width:auto" onchange="this.form.requestSubmit()">
            <option value="">Tüm şubeler</option>
            @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(f.BranchId == b.Id)">@b.Name</option> }
        </select>
        <button class="btn btn-ghost">Ara</button>
        <span class="ms-auto small text-muted">@Model.Reservations.TotalCount kayıt</span>
    </form>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Kod</th><th>Müşteri</th><th>Araç</th><th>Alış → İade</th><th>Durum</th><th class="text-end">Tutar</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reservations.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@r.Id" class="fw-semibold tabular">@r.Code</a></td>
                        <td>
                            <div class="fw-semibold">@r.Customer!.FullName</div>
                            <div class="small text-muted">@r.Customer.Email</div>
                        </td>
                        <td>
                            <div>@r.Vehicle!.DisplayName</div>
                            <span class="kbd-plate">@r.Vehicle.Plate</span>
                        </td>
                        <td class="small">
                            <div>@Fmt.DateTime(r.StartDate) <span class="text-muted">· @r.PickupBranch!.Name</span></div>
                            <div>@Fmt.DateTime(r.EndDate) <span class="text-muted">· @r.ReturnBranch!.Name</span></div>
                        </td>
                        <td><partial name="_StatusBadge" model="r" /></td>
                        <td class="text-end tabular fw-semibold">@Fmt.Money(r.TotalPrice)</td>
                        <td class="text-end text-nowrap">
                            @switch (r.Status)
                            {
                                case ReservationStatus.Pending:
                                    <form asp-action="Approve" asp-route-id="@r.Id" method="post" class="d-inline">
                                        <button class="btn btn-sm btn-primary">Onayla</button>
                                    </form>
                                    break;
                                case ReservationStatus.Approved:
                                    <a asp-action="Deliver" asp-route-id="@r.Id" class="btn btn-sm btn-soft">Teslim et</a>
                                    break;
                                case ReservationStatus.Active:
                                    <a asp-action="Return" asp-route-id="@r.Id" class="btn btn-sm btn-soft">İade al</a>
                                    break;
                            }
                            <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-ghost" aria-label="Detay"><i class="bi bi-chevron-right"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Reservations.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-journal-x"></i>Bu kriterlere uygun rezervasyon yok.</div>
    }
</div>

@await Html.PartialAsync("_Pagination", (Model.Reservations.TotalPages, Model.Reservations.Page,
    (Func<int, string>)(p => Url.Action("Index", new { f.Status, f.Q, f.BranchId, f.OverdueOnly, Page = p })!)))
