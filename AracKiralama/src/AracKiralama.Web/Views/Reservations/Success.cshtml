@model Reservation
@{
    ViewData["Title"] = "Talebiniz alındı";
}
<div class="container py-5" style="max-width: 760px">
    <div class="text-center mb-4">
        <span class="kpi d-inline-flex p-0 mb-3"><span class="ico ico-success" style="width:64px;height:64px;font-size:2rem;border-radius:50%"><i class="bi bi-check-lg"></i></span></span>
        <h1 class="h3">Rezervasyon talebiniz alındı!</h1>
        <p class="text-muted">Ekibimiz talebinizi kısa süre içinde onaylayacak. Durumu "Rezervasyonlarım" sayfasından takip edebilirsiniz.</p>
        <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 bg-brand-soft">
            <span class="small text-muted">Rezervasyon kodu</span>
            <b class="fs-5 text-brand tabular">@Model.Code</b>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="d-flex gap-3 align-items-center mb-3">
                <img src="@Model.Vehicle!.ImageUrl" alt="" class="thumb" style="width:96px;height:62px" />
                <div>
                    <div class="fw-bold">@Model.Vehicle.DisplayName</div>
                    <partial name="_StatusBadge" model="Model" />
                </div>
            </div>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="small-caps">Alış</div>
                    <div class="fw-semibold">@Model.PickupBranch!.Name</div>
                    <div class="text-muted small">@Fmt.DateTime(Model.StartDate)</div>
                </div>
                <div class="col-sm-6">
                    <div class="small-caps">İade</div>
                    <div class="fw-semibold">@Model.ReturnBranch!.Name</div>
                    <div class="text-muted small">@Fmt.DateTime(Model.EndDate)</div>
                </div>
            </div>
            <div class="divider"></div>
            <ul class="breakdown">
                <li><span>@Model.TotalDays gün × @Fmt.Money(Model.DailyPrice)</span><span>@Fmt.Money(Model.BaseTotal)</span></li>
                @if (Model.DiscountAmount > 0) { <li class="discount"><span>Uzun dönem indirimi</span><span>− @Fmt.Money(Model.DiscountAmount)</span></li> }
                @foreach (var e in Model.Extras) { <li><span>@e.Extra!.Name</span><span>@Fmt.Money(e.Total)</span></li> }
                @if (Model.OneWayFee > 0) { <li><span>Farklı şubeye iade</span><span>@Fmt.Money(Model.OneWayFee)</span></li> }
                <li class="total"><span>Toplam</span><span>@Fmt.Money(Model.TotalPrice)</span></li>
            </ul>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-2 mt-4">
        <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">Rezervasyonlarım</a>
        <a asp-controller="Vehicles" asp-action="Index" class="btn btn-ghost">Araçlara dön</a>
    </div>
</div>
