@model MaintenanceFormViewModel
@{
    ViewData["Title"] = "Bakım kaydı";
}
<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Bakım</a>
        <h1 class="mt-1">Yeni bakım kaydı</h1>
        <div class="sub">Bakım tarihleri arasında araç kiralamaya kapatılır.</div>
    </div>
</div>

<form asp-action="Create" method="post" class="card" style="max-width:760px" novalidate>
    <div class="card-body row g-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small col-12"></div>
        <div class="col-md-8">
            <label asp-for="VehicleId" class="form-label"></label>
            <select asp-for="VehicleId" class="form-select"
                    asp-items="@(new SelectList(Model.Vehicles.Select(v => new { v.Id, Text = $"{v.DisplayName} · {v.Plate}" }), "Id", "Text"))">
                <option value="">Seçiniz</option>
            </select>
            <span asp-validation-for="VehicleId"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<MaintenanceType>()"></select>
        </div>
        <div class="col-md-6">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Fmt.Input(Model.StartDate)" />
        </div>
        <div class="col-md-6">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="datetime-local" class="form-control" value="@Fmt.Input(Model.EndDate)" />
            <span asp-validation-for="EndDate"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Kilometers" class="form-label"></label>
            <input asp-for="Kilometers" class="form-control" />
        </div>
        <div class="col-md-6">
            <label asp-for="Cost" class="form-label"></label>
            <input asp-for="Cost" class="form-control" step="50" />
        </div>
        <div class="col-12">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <div class="card-body border-top d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-ghost">Vazgeç</a>
        <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Kaydet</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
