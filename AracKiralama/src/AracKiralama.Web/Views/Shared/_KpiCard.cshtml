@* Gösterge kartı. Tone: brand | success | warning | danger | info *@
@model KpiModel
<div class="card h-100 @(Model.Url is not null ? "position-relative" : "")">
    <div class="kpi">
        <span class="ico ico-@Model.Tone"><i class="bi @Model.Icon"></i></span>
        <div class="min-w-0">
            <div class="label">@Model.Label</div>
            <div class="value tabular">@Model.Value</div>
            @if (Model.Hint is not null) { <div class="hint">@Html.Raw(Model.Hint)</div> }
        </div>
    </div>
    @if (Model.Url is not null) { <a href="@Model.Url" class="stretched-link" aria-label="@Model.Label"></a> }
</div>
