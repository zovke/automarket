@* Rezervasyon durumu rozeti. Kullanım: <partial name="_StatusBadge" model="reservation" /> *@
@model Reservation
@if (Model.Status == ReservationStatus.Active && Model.EndDate < DateTime.Now)
{
    <span class="status status-overdue">Gecikmiş</span>
}
else
{
    <span class="status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status.GetDisplayName()</span>
}
