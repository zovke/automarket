@model CalendarViewModel
@{
    ViewData["Title"] = "Doluluk Takvimi";
    var today = DateTime.Today;
    var prev = Model.From.AddDays(-7);
    var next = Model.From.AddDays(7);
}

<div class="page-head">
    <div>
        <h1>Doluluk Takvimi</h1>
        <div class="sub">@Fmt.Date(Model.From) – @Fmt.Date(Model.From.AddDays(Model.Days - 1)) · @Model.Rows.Count araç</div>
    </div>
    <form method="get" class="d-flex flex-wrap gap-2" data-auto-submit>
        <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
        <select name="branchId" class="form-select form-select-sm" style="width:auto">
            <option value="">Tüm şubeler</option>
            @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(Model.BranchId == b.Id)">@b.Name</option> }
        </select>
        <select name="category" class="form-select form-select-sm" style="width:auto">
            <option value="">Tüm kategoriler</option>
            @foreach (var c in Enum.GetValues<VehicleCategory>()) { <option value="@c" selected="@(Model.Category == c)">@c.GetDisplayName()</option> }
        </select>
        <select name="days" class="form-select form-select-sm" style="width:auto">
            @foreach (var d in new[] { 14, 21, 30, 42 }) { <option value="@d" selected="@(Model.Days == d)">@d gün</option> }
        </select>
        <div class="btn-group">
            <a class="btn btn-ghost btn-sm" asp-route-from="@prev.ToString("yyyy-MM-dd")" asp-route-days="@Model.Days" asp-route-branchId="@Model.BranchId" asp-route-category="@Model.Category" aria-label="Önceki hafta"><i class="bi bi-chevron-left"></i></a>
            <a class="btn btn-ghost btn-sm" asp-route-days="@Model.Days" asp-route-branchId="@Model.BranchId" asp-route-category="@Model.Category">Bugün</a>
            <a class="btn btn-ghost btn-sm" asp-route-from="@next.ToString("yyyy-MM-dd")" asp-route-days="@Model.Days" asp-route-branchId="@Model.BranchId" asp-route-category="@Model.Category" aria-label="Sonraki hafta"><i class="bi bi-chevron-right"></i></a>
        </div>
    </form>
</div>

<div class="legend mb-3">
    <span><i class="blk-pending"></i>Onay bekliyor</span>
    <span><i class="blk-approved"></i>Onaylandı</span>
    <span><i class="blk-active"></i>Kirada</span>
    <span><i class="blk-overdue"></i>Gecikmiş</span>
    <span><i class="blk-completed"></i>Tamamlandı</span>
    <span><i class="blk-maintenance"></i>Bakım</span>
</div>

<div class="card table-card">
    <div class="occ-wrap">
        @* --days CSS değişkeni sütun sayısını belirler (site.css → .occ-grid) *@
        <div class="occ-grid" style="--days:@Model.Days">
            <div class="occ-head">
                <div class="occ-name small-caps">Araç</div>
                @foreach (var d in Model.Dates)
                {
                    var weekend = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                    <div class="day @(d == today ? "today" : "") @(weekend ? "weekend" : "")">@Fmt.DayName(d)<b>@d.Day</b></div>
                }
            </div>

            @foreach (var row in Model.Rows)
            {
                <div class="occ-row">
                    <a class="occ-name text-reset" asp-controller="Vehicles" asp-action="Details" asp-route-id="@row.Vehicle.Id">
                        <span class="fw-semibold small text-truncate">@row.Vehicle.DisplayName</span>
                        <span class="plate">@row.Vehicle.Plate</span>
                    </a>
                    @for (var i = 0; i < Model.Days; i++)
                    {
                        var d = Model.Dates[i];
                        var weekend = d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
                        <div class="cell @(d == today ? "today" : "") @(weekend ? "weekend" : "")" style="grid-column:@(i + 2)"></div>
                    }
                    @foreach (var b in row.Blocks)
                    {
                        <a href="@b.Url" class="occ-block @b.CssClass" style="grid-column:@(b.StartCol + 1) / span @b.Span" title="@b.Tooltip" data-bs-toggle="tooltip">@b.Label</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (Model.Rows.Count == 0)
{
    <div class="empty-state"><i class="bi bi-car-front"></i>Filtreye uygun araç yok.</div>
}
