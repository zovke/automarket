@model AppUser
@{
    var u = Model;
    ViewData["Title"] = u.FullName;
    var completed = u.Reservations.Where(r => r.Status == ReservationStatus.Completed).ToList();
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Müşteriler</a>
        <h1 class="d-flex align-items-center gap-2 mt-1">@u.FullName @if (u.IsBlacklisted) { <span class="status status-rejected">Kara liste</span> }</h1>
        <div class="sub">Üyelik: @Fmt.Date(u.CreatedAt)</div>
    </div>
    @if (u.IsBlacklisted)
    {
        <form asp-action="ToggleBlacklist" asp-route-id="@u.Id" method="post">
            <button class="btn btn-ghost"><i class="bi bi-unlock me-1"></i>Kara listeden çıkar</button>
        </form>
    }
    else
    {
        <button class="btn btn-ghost text-danger" data-bs-toggle="modal" data-bs-target="#blModal"><i class="bi bi-slash-circle me-1"></i>Kara listeye al</button>
    }
</div>

@if (u.IsBlacklisted)
{
    <div class="alert alert-danger"><b>Kara liste sebebi:</b> @u.BlacklistReason — Bu müşteri yeni rezervasyon yapamaz.</div>
}

<div class="row g-3 mb-3">
    <div class="col-md-4">@await Html.PartialAsync("_KpiCard", new KpiModel("Tamamlanan kiralama", completed.Count.ToString(), "bi-journal-check", "brand"))</div>
    <div class="col-md-4">@await Html.PartialAsync("_KpiCard", new KpiModel("Toplam harcama", Fmt.Money(completed.Sum(r => r.TotalPrice)), "bi-cash-stack", "success"))</div>
    <div class="col-md-4">@await Html.PartialAsync("_KpiCard", new KpiModel("Toplam gün", completed.Sum(r => r.TotalDays).ToString(), "bi-calendar3", "info"))</div>
</div>

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header">Bilgiler</div>
            <div class="card-body small d-grid gap-2">
                <div><div class="small-caps">E-posta</div>@u.Email</div>
                <div><div class="small-caps">Telefon</div>@(u.PhoneNumber ?? "-")</div>
                <div><div class="small-caps">T.C. Kimlik No</div>@(u.TcNo ?? "-")</div>
                <div><div class="small-caps">Doğum tarihi</div>@(u.BirthDate is { } b ? $"{Fmt.Date(b)} ({ReservationService.YearsBetween(b, DateTime.Today)} yaş)" : "-")</div>
                <div><div class="small-caps">Ehliyet</div>@(u.LicenseNumber ?? "-") · @(u.LicenseIssueDate is { } l ? $"{Fmt.Date(l)} ({ReservationService.YearsBetween(l, DateTime.Today)} yıl)" : "-")</div>
            </div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card table-card">
            <div class="card-header">Rezervasyon geçmişi</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Kod</th><th>Araç</th><th>Tarih</th><th>Durum</th><th class="text-end">Tutar</th></tr></thead>
                    <tbody>
                        @foreach (var r in u.Reservations.OrderByDescending(r => r.StartDate))
                        {
                            <tr>
                                <td><a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="tabular">@r.Code</a></td>
                                <td>@r.Vehicle!.DisplayName</td>
                                <td class="small text-muted">@Fmt.Date(r.StartDate) – @Fmt.Date(r.EndDate)</td>
                                <td><partial name="_StatusBadge" model="r" /></td>
                                <td class="text-end tabular">@Fmt.Money(r.TotalPrice)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (u.Reservations.Count == 0) { <div class="empty-state py-4">Rezervasyon yok.</div> }
        </div>
    </div>
</div>

<div class="modal fade" id="blModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="ToggleBlacklist" asp-route-id="@u.Id" method="post" class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">Kara listeye al</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
            <div class="modal-body">
                <label class="form-label" for="reason">Sebep</label>
                <input id="reason" name="reason" class="form-control" maxlength="250" placeholder="Örn: Ödenmemiş hasar bedeli" />
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-danger">Kara listeye al</button></div>
        </form>
    </div>
</div>
