@model List<Extra>
@{
    ViewData["Title"] = "Ek Hizmetler";
    var usage = (Dictionary<int, int>)ViewBag.UsageCounts;
}
<div class="page-head">
    <div><h1>Ek Hizmetler</h1><div class="sub">Rezervasyona eklenebilen günlük ücretli hizmetler</div></div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni hizmet</a>
</div>

<div class="card table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Hizmet</th><th class="text-end">Günlük</th><th class="text-end">Kullanım</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr class="@(x.IsActive ? "" : "opacity-50")">
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <span class="kpi p-0"><span class="ico ico-brand" style="width:38px;height:38px;font-size:1.05rem"><i class="bi @x.Icon"></i></span></span>
                                <div><div class="fw-semibold">@x.Name</div><div class="small text-muted">@x.Description</div></div>
                            </div>
                        </td>
                        <td class="text-end tabular fw-semibold">@Fmt.Money(x.DailyPrice)</td>
                        <td class="text-end tabular">@usage.GetValueOrDefault(x.Id) kez</td>
                        <td>@if (x.IsActive) { <span class="status status-available">Aktif</span> } else { <span class="status status-passive">Pasif</span> }</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-ghost" aria-label="Düzenle"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@x.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-ghost text-danger" data-confirm="@x.Name silinsin mi?" aria-label="Sil"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
