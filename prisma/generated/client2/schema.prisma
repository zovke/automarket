generator client {
  provider = "prisma-client-js"
  output   = "./generated/client2"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  firstName String?
  lastName  String?
  favorites Favorite[]
  listings  Listing[]
  requests  Request[]
}

model Listing {
  id           String     @id @default(cuid())
  title        String
  description  String
  price        Float
  category     Category
  createdAt    DateTime   @default(now())
  userId       String
  brand        String?
  fuel         String?
  images       String?
  isAvailable  Boolean    @default(true)
  kilometers   Int?
  model        String?
  transmission String?
  year         Int?
  favorites    Favorite[]
  user         User       @relation(fields: [userId], references: [id])
  requests     Request[]
}

model Request {
  id        String   @id @default(cuid())
  status    String   @default("PENDING")
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

enum Role {
  USER
  ADMIN
}

enum Category {
  SALE
  RENT
  PART
}
