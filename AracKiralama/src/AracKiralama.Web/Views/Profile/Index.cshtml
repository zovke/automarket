@model MyReservationsViewModel
@{
    ViewData["Title"] = "Rezervasyonlarım";
}

<div class="container py-4">
    <div class="page-head">
        <div>
            <h1 class="h3 mb-0">Merhaba, @Model.User.FirstName 👋</h1>
            <div class="sub">Rezervasyonlarınızı buradan takip edebilir, iptal edebilir veya sözleşmenizi indirebilirsiniz.</div>
        </div>
        <a asp-action="Edit" class="btn btn-ghost"><i class="bi bi-person-gear me-1"></i>Profil ve ehliyet</a>
    </div>

    @if (!Model.ProfileComplete)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
            <i class="bi bi-exclamation-triangle"></i>
            <span>Rezervasyon yapabilmek için doğum tarihi ve ehliyet bilgilerinizi tamamlayın.</span>
            <a asp-action="Edit" class="btn btn-sm btn-ghost ms-auto">Şimdi tamamla</a>
        </div>
    }

    <h2 class="h5 mt-4 mb-3">Aktif ve yaklaşan</h2>
    @if (Model.Upcoming.Count == 0)
    {
        <div class="card empty-state">
            <i class="bi bi-calendar2-plus"></i>
            <p class="mb-3">Yaklaşan bir rezervasyonunuz yok.</p>
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary">Araç kirala</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.Upcoming)
            {
                <div class="col-lg-6">
                    <div class="card h-100">
                        <div class="card-body d-flex gap-3">
                            <img src="@r.Vehicle!.ImageUrl" alt="" class="rounded-3 flex-none d-none d-sm-block" style="width:128px;height:84px;object-fit:cover" />
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between gap-2">
                                    <div>
                                        <div class="fw-bold">@r.Vehicle.DisplayName</div>
                                        <div class="small text-muted tabular">@r.Code</div>
                                    </div>
                                    <div><partial name="_StatusBadge" model="r" /></div>
                                </div>
                                <div class="small mt-2">
                                    <div><i class="bi bi-box-arrow-in-right text-muted me-1"></i>@r.PickupBranch!.Name · @Fmt.DateTime(r.StartDate)</div>
                                    <div><i class="bi bi-box-arrow-left text-muted me-1"></i>@r.ReturnBranch!.Name · @Fmt.DateTime(r.EndDate)</div>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                                    <span class="fw-bold me-auto">@Fmt.Money(r.TotalPrice)</span>
                                    @if (r.Status != ReservationStatus.Pending)
                                    {
                                        <a asp-action="Contract" asp-route-id="@r.Id" target="_blank" class="btn btn-sm btn-ghost"><i class="bi bi-file-earmark-pdf me-1"></i>Sözleşme</a>
                                    }
                                    @if (r.CanBeCancelled)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@r.Id" method="post">
                                            <button class="btn btn-sm btn-ghost text-danger" data-confirm="@r.Code kodlu rezervasyonu iptal etmek istediğinize emin misiniz? Alış saatine 24 saatten az kaldıysa 1 günlük ücret kesilir.">İptal et</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <h2 class="h5 mt-5 mb-3">Geçmiş</h2>
    @if (Model.Past.Count == 0)
    {
        <p class="text-muted">Henüz tamamlanmış bir kiralamanız yok.</p>
    }
    else
    {
        <div class="card table-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>Kod</th><th>Araç</th><th>Tarih</th><th>Durum</th><th class="text-end">Tutar</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in Model.Past)
                        {
                            <tr>
                                <td class="tabular small">@r.Code</td>
                                <td class="fw-semibold">@r.Vehicle!.DisplayName</td>
                                <td class="small text-muted">@Fmt.Date(r.StartDate) – @Fmt.Date(r.EndDate)</td>
                                <td><partial name="_StatusBadge" model="r" /></td>
                                <td class="text-end tabular">@Fmt.Money(r.Status == ReservationStatus.Cancelled ? r.CancellationFee : r.TotalPrice)</td>
                                <td class="text-end">
                                    @if (r.Status == ReservationStatus.Completed)
                                    {
                                        <a asp-action="Contract" asp-route-id="@r.Id" target="_blank" class="btn btn-sm btn-ghost" title="Sözleşmeyi indir"><i class="bi bi-file-earmark-pdf"></i></a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
