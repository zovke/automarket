@* Ekleme ve düzenleme aynı formu kullanır (Id doluysa düzenleme). *@
@model VehicleFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Aracı düzenle" : "Yeni araç";
}

<div class="page-head">
    <div>
        <a asp-action="@(isEdit ? "Details" : "Index")" asp-route-id="@Model.Id" class="small"><i class="bi bi-arrow-left me-1"></i>Geri</a>
        <h1 class="mt-1">@ViewData["Title"]</h1>
    </div>
</div>

<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card mb-3">
                <div class="card-header">Araç bilgileri</div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        <label asp-for="Plate" class="form-label"></label>
                        <input asp-for="Plate" class="form-control text-uppercase" placeholder="34 ABC 123" />
                        <span asp-validation-for="Plate"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BrandId" class="form-label"></label>
                        <select asp-for="BrandId" class="form-select" asp-items="@(new SelectList(Model.Brands, "Id", "Name"))">
                            <option value="">Seçiniz</option>
                        </select>
                        <span asp-validation-for="BrandId"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Year" class="form-label"></label>
                        <input asp-for="Year" class="form-control" />
                        <span asp-validation-for="Year"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Category" class="form-label"></label>
                        <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<VehicleCategory>()"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Fuel" class="form-label"></label>
                        <select asp-for="Fuel" class="form-select" asp-items="Html.GetEnumSelectList<FuelType>()"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Transmission" class="form-label"></label>
                        <select asp-for="Transmission" class="form-select" asp-items="Html.GetEnumSelectList<TransmissionType>()"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Seats" class="form-label"></label>
                        <input asp-for="Seats" class="form-control" />
                        <span asp-validation-for="Seats"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" />
                        <span asp-validation-for="Color"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Kilometers" class="form-label"></label>
                        <input asp-for="Kilometers" class="form-control" />
                        <span asp-validation-for="Kilometers"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="BranchId" class="form-label"></label>
                        <select asp-for="BranchId" class="form-select" asp-items="@(new SelectList(Model.Branches, "Id", "Name"))"></select>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">Fiyat ve kiralama şartları</div>
                <div class="card-body row g-3">
                    <div class="col-md-3">
                        <label asp-for="DailyPrice" class="form-label"></label>
                        <input asp-for="DailyPrice" class="form-control" step="50" />
                        <span asp-validation-for="DailyPrice"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Deposit" class="form-label"></label>
                        <input asp-for="Deposit" class="form-control" step="500" />
                        <span asp-validation-for="Deposit"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MinDriverAge" class="form-label"></label>
                        <input asp-for="MinDriverAge" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="MinLicenseYears" class="form-label"></label>
                        <input asp-for="MinLicenseYears" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<VehicleStatus>()"></select>
                        <div class="form-text">"Pasif" araçlar sitede listelenmez.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card">
                <div class="card-header">Görsel</div>
                <div class="card-body">
                    <div class="detail-media mb-3">
                        <img id="preview" src="@(Model.ImageUrl ?? "/img/placeholder.svg")" alt="Önizleme" />
                    </div>
                    <input asp-for="Image" type="file" class="form-control" accept="image/png,image/jpeg,image/webp" data-image-preview="#preview" />
                    <span asp-validation-for="Image"></span>
                    <div class="form-text">JPG, PNG veya WEBP · en fazla 5 MB</div>
                </div>
            </div>
            <div class="d-grid gap-2 mt-3">
                <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-check2 me-1"></i>Kaydet</button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
