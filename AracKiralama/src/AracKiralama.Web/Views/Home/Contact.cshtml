@{
    ViewData["Title"] = "İletişim";
}
<div class="container py-5" style="max-width: 960px">
    <div class="text-center mb-5">
        <div class="section-eyebrow mb-2">İletişim</div>
        <h1 class="section-title">Size nasıl yardımcı olabiliriz?</h1>
        <p class="text-muted">Rezervasyon, fatura veya kurumsal kiralama talepleriniz için bize ulaşın.</p>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card step-card text-center">
                <span class="ico mx-auto"><i class="bi bi-telephone"></i></span>
                <h2 class="h6">Çağrı merkezi</h2>
                <p class="mb-0 fw-semibold">@Site.Value.Phone</p>
                <p class="small text-muted mb-0">Her gün 08:00 – 22:00</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card step-card text-center">
                <span class="ico mx-auto"><i class="bi bi-envelope"></i></span>
                <h2 class="h6">E-posta</h2>
                <p class="mb-0 fw-semibold">@Site.Value.Email</p>
                <p class="small text-muted mb-0">24 saat içinde dönüş</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card step-card text-center">
                <span class="ico mx-auto"><i class="bi bi-building"></i></span>
                <h2 class="h6">Genel merkez</h2>
                <p class="small mb-0">@Site.Value.Address</p>
            </div>
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Home")#subeler" class="btn btn-soft">Tüm şubeleri gör <i class="bi bi-arrow-right ms-1"></i></a>
    </div>
</div>
