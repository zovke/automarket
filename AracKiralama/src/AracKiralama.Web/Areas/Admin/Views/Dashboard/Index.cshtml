@model DashboardData
@using System.Text.Json
@{
    ViewData["Title"] = "Gösterge Paneli";
    var change = Model.PreviousPeriodRevenue == 0 ? 0 : (double)((Model.MonthRevenue - Model.PreviousPeriodRevenue) / Model.PreviousPeriodRevenue);
    var trend = change >= 0
        ? $"<span class='trend-up'><i class='bi bi-arrow-up-right'></i> %{change * 100:0}</span> geçen ayın aynı dönemine göre"
        : $"<span class='trend-down'><i class='bi bi-arrow-down-right'></i> %{-change * 100:0}</span> geçen ayın aynı dönemine göre";
    string Link(string controller, object? values = null) => Url.Action("Index", controller, values)!;
}

<div class="page-head">
    <div>
        <h1>Gösterge Paneli</h1>
        <div class="sub">@Fmt.Date(DateTime.Today), @DateTime.Today.ToString("dddd", Fmt.Tr) · Filonun anlık durumu</div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Calendar" asp-action="Index" class="btn btn-ghost"><i class="bi bi-calendar3-range me-1"></i>Takvim</a>
        <a asp-controller="Vehicles" asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Araç ekle</a>
    </div>
</div>

@if (Model.OverdueCount > 0)
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2">
        <i class="bi bi-alarm fs-5"></i>
        <div><b>@Model.OverdueCount kiralama gecikmede.</b> İade tarihi geçtiği halde araç teslim edilmedi.</div>
        <a href="@Link("Reservations", new { OverdueOnly = true })" class="btn btn-sm btn-danger ms-auto">Görüntüle</a>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        @await Html.PartialAsync("_KpiCard", new KpiModel(DateTime.Today.ToString("MMMM", Fmt.Tr) + " geliri", Fmt.Money(Model.MonthRevenue), "bi-graph-up-arrow", "brand", trend, Link("Reports")))
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        @await Html.PartialAsync("_KpiCard", new KpiModel("Doluluk oranı", $"%{Model.OccupancyRate * 100:0}", "bi-speedometer2", "info", $"{Model.RentedNow} / {Model.TotalVehicles} araç kirada", Link("Calendar")))
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        @await Html.PartialAsync("_KpiCard", new KpiModel("Onay bekleyen", Model.PendingCount.ToString(), "bi-hourglass-split", "warning", "yeni rezervasyon talebi", Link("Reservations", new { Status = ReservationStatus.Pending })))
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        @await Html.PartialAsync("_KpiCard", new KpiModel("Bakımda", Model.InMaintenance.ToString(), "bi-tools", Model.InMaintenance > 0 ? "danger" : "success", "araç servis sürecinde", Link("Maintenance", new { openOnly = true })))
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Aylık gelir (son 12 ay)</span>
                <span class="small text-muted">Tamamlanan kiralamalar</span>
            </div>
            <div class="card-body"><div class="chart-box"><canvas id="revenueChart" aria-label="Aylık gelir grafiği" role="img"></canvas></div></div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header">Kategoriye göre kiralama</div>
            <div class="card-body"><div class="chart-box"><canvas id="categoryChart" aria-label="Kategori dağılımı" role="img"></canvas></div></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6 col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between"><span><i class="bi bi-box-arrow-up-right text-brand me-2"></i>Bugün teslim edilecek</span><span class="badge text-bg-light">@Model.TodayPickups.Count</span></div>
            @if (Model.TodayPickups.Count == 0) { <div class="empty-state py-4"><i class="bi bi-check2-all"></i>Bugün teslim yok</div> }
            <ul class="mini-list">
                @foreach (var r in Model.TodayPickups)
                {
                    <li>
                        <div class="min-w-0 flex-grow-1">
                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="fw-semibold text-reset">@r.Vehicle!.DisplayName</a>
                            <div class="meta">@r.Customer!.FullName · @r.StartDate.ToString("HH:mm") · @r.PickupBranch!.Name</div>
                        </div>
                        <a asp-controller="Reservations" asp-action="Deliver" asp-route-id="@r.Id" class="btn btn-sm btn-soft">Teslim et</a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6 col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between"><span><i class="bi bi-box-arrow-in-down-left text-brand me-2"></i>Bugün iade alınacak</span><span class="badge text-bg-light">@Model.TodayReturns.Count</span></div>
            @if (Model.TodayReturns.Count == 0) { <div class="empty-state py-4"><i class="bi bi-check2-all"></i>Bugün iade yok</div> }
            <ul class="mini-list">
                @foreach (var r in Model.TodayReturns.Concat(Model.Overdue))
                {
                    <li>
                        <div class="min-w-0 flex-grow-1">
                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="fw-semibold text-reset">@r.Vehicle!.DisplayName</a>
                            <div class="meta">@r.Customer!.FullName · @Fmt.DateTime(r.EndDate) · @r.ReturnBranch!.Name</div>
                        </div>
                        <partial name="_StatusBadge" model="r" />
                        <a asp-controller="Reservations" asp-action="Return" asp-route-id="@r.Id" class="btn btn-sm btn-soft">İade al</a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6 col-xl-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between"><span><i class="bi bi-hourglass-split text-warning me-2"></i>Onay bekleyen talepler</span><a asp-controller="Reservations" asp-action="Index" asp-route-Status="Pending" class="small">Tümü</a></div>
            @if (Model.LatestPending.Count == 0) { <div class="empty-state py-4"><i class="bi bi-inbox"></i>Bekleyen talep yok</div> }
            <ul class="mini-list">
                @foreach (var r in Model.LatestPending)
                {
                    <li>
                        <div class="min-w-0 flex-grow-1">
                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id" class="fw-semibold text-reset">@r.Customer!.FullName</a>
                            <div class="meta">@r.Vehicle!.DisplayName · @Fmt.Date(r.StartDate) · @r.TotalDays gün</div>
                        </div>
                        <span class="fw-semibold small tabular">@Fmt.Money(r.TotalPrice)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-lg-6 col-xl-12">
        <div class="card h-100">
            <div class="card-header">En çok kiralanan 5 araç</div>
            <div class="card-body">
                @{ var max = Model.TopVehicles.Count == 0 ? 1 : Model.TopVehicles.Max(x => x.Value); }
                @foreach (var t in Model.TopVehicles)
                {
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span class="fw-semibold">@t.Label</span><span class="text-muted">@t.Value kiralama</span></div>
                        <div class="progress"><div class="progress-bar" style="width:@((t.Value / max * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Grafik verisi: çalıştırılmayan JSON bloğu → wwwroot/js/admin-charts.js okur *@
    <script type="application/json" id="chart-data">@Html.Raw(JsonSerializer.Serialize(new { monthly = Model.MonthlyRevenue, categories = Model.CategoryShare }))</script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/admin-charts.js" asp-append-version="true"></script>
}
