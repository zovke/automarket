@model Reservation
@{
    var r = Model;
    ViewData["Title"] = r.Code;
    var payment = (PaymentFormViewModel)ViewBag.Payment;
    var estimatedLate = (decimal)ViewBag.EstimatedLateFee;
    var isClosed = r.Status is ReservationStatus.Cancelled or ReservationStatus.Rejected;
    string Step(bool done, bool current = false, bool bad = false) => bad ? "bad" : current ? "current" : done ? "done" : "";
}

<div class="page-head">
    <div>
        <a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Rezervasyonlar</a>
        <h1 class="d-flex align-items-center gap-2 mt-1">@r.Code <partial name="_StatusBadge" model="r" /></h1>
        <div class="sub">Oluşturulma: @Fmt.DateTime(r.CreatedAt)@(r.HandledBy is not null ? $" · Son işlem: {r.HandledBy.FullName}" : "")</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (r.Status == ReservationStatus.Pending)
        {
            <form asp-action="Approve" asp-route-id="@r.Id" method="post">
                <button class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Onayla</button>
            </form>
            <button class="btn btn-ghost text-danger" data-bs-toggle="modal" data-bs-target="#rejectModal"><i class="bi bi-x-lg me-1"></i>Reddet</button>
        }
        @if (r.Status == ReservationStatus.Approved)
        {
            <a asp-action="Deliver" asp-route-id="@r.Id" class="btn btn-primary"><i class="bi bi-key me-1"></i>Aracı teslim et</a>
        }
        @if (r.Status == ReservationStatus.Active)
        {
            <a asp-action="Return" asp-route-id="@r.Id" class="btn btn-primary"><i class="bi bi-box-arrow-in-down-left me-1"></i>İade al</a>
        }
        @if (r.CanBeCancelled)
        {
            <form asp-action="Cancel" asp-route-id="@r.Id" method="post">
                <button class="btn btn-ghost" data-confirm="Rezervasyon iptal edilsin mi? (Personel iptalinde ücret kesilmez)">İptal et</button>
            </form>
        }
        @if (r.Status is not ReservationStatus.Pending and not ReservationStatus.Rejected)
        {
            <a asp-action="Contract" asp-route-id="@r.Id" target="_blank" class="btn btn-ghost"><i class="bi bi-file-earmark-pdf me-1"></i>Sözleşme PDF</a>
        }
    </div>
</div>

@if (r.StatusReason is not null && isClosed)
{
    <div class="alert alert-secondary"><i class="bi bi-info-circle me-1"></i>@r.StatusReason</div>
}
@if (estimatedLate > 0)
{
    <div class="alert alert-danger"><i class="bi bi-alarm me-1"></i>Araç <b>@Fmt.DateTime(r.EndDate)</b> tarihinde iade edilmeliydi. Şu an iade alınırsa tahmini gecikme ücreti: <b>@Fmt.Money(estimatedLate)</b></div>
}

<div class="row g-3">
    <div class="col-xl-8">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header"><i class="bi bi-car-front me-2 text-brand"></i>Araç</div>
                    <div class="card-body d-flex gap-3">
                        <img src="@r.Vehicle!.ImageUrl" alt="" class="rounded-3" style="width:120px;height:78px;object-fit:cover" />
                        <div>
                            <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@r.VehicleId" class="fw-bold text-reset">@r.Vehicle.DisplayName</a>
                            <div class="my-1"><span class="kbd-plate">@r.Vehicle.Plate</span></div>
                            <div class="small text-muted">@r.Vehicle.Category.GetDisplayName() · @r.Vehicle.Transmission.GetDisplayName() · @r.Vehicle.Fuel.GetDisplayName()</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-header"><i class="bi bi-person me-2 text-brand"></i>Müşteri</div>
                    <div class="card-body">
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@r.CustomerId" class="fw-bold text-reset">@r.Customer!.FullName</a>
                        @if (r.Customer!.IsBlacklisted) { <span class="status status-rejected ms-1">Kara liste</span> }
                        <div class="small text-muted mt-1"><i class="bi bi-envelope me-1"></i>@r.Customer.Email</div>
                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@(r.Customer.PhoneNumber ?? "-")</div>
                        <div class="small text-muted"><i class="bi bi-person-vcard me-1"></i>Ehliyet: @(r.Customer.LicenseNumber ?? "-") · @(r.Customer.LicenseIssueDate is { } l ? Fmt.Date(l) : "-")</div>
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header"><i class="bi bi-signpost-2 me-2 text-brand"></i>Kiralama süreci</div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <ul class="timeline">
                                    <li class="done"><span class="dot"></span><div class="fw-semibold">Talep oluşturuldu</div><div class="small text-muted">@Fmt.DateTime(r.CreatedAt)</div></li>
                                    <li class="@Step(r.Status is not ReservationStatus.Pending, r.Status == ReservationStatus.Pending, r.Status == ReservationStatus.Rejected)"><span class="dot"></span>
                                        <div class="fw-semibold">@(r.Status == ReservationStatus.Rejected ? "Reddedildi" : "Onay")</div>
                                        <div class="small text-muted">@(r.Status == ReservationStatus.Pending ? "Personel onayı bekleniyor" : r.Status == ReservationStatus.Rejected ? r.StatusReason : "Onaylandı")</div>
                                    </li>
                                    <li class="@Step(r.DeliveredAt.HasValue, r.Status == ReservationStatus.Approved)"><span class="dot"></span>
                                        <div class="fw-semibold">Teslim · @r.PickupBranch!.Name</div>
                                        <div class="small text-muted">Planlanan @Fmt.DateTime(r.StartDate)@(r.DeliveredAt is { } d ? $" · Gerçekleşen {Fmt.DateTime(d)}" : "")</div>
                                        @if (r.StartKm.HasValue) { <div class="small text-muted">@Fmt.Number(r.StartKm.Value) km · Yakıt @r.FuelLevelOut?.GetDisplayName()</div> }
                                    </li>
                                    <li class="@Step(r.ActualReturnDate.HasValue, r.Status == ReservationStatus.Active, estimatedLate > 0)"><span class="dot"></span>
                                        <div class="fw-semibold">İade · @r.ReturnBranch!.Name</div>
                                        <div class="small text-muted">Planlanan @Fmt.DateTime(r.EndDate)@(r.ActualReturnDate is { } a ? $" · Gerçekleşen {Fmt.DateTime(a)}" : "")</div>
                                        @if (r.EndKm.HasValue) { <div class="small text-muted">@Fmt.Number(r.EndKm.Value) km (+@Fmt.Number(r.EndKm.Value - (r.StartKm ?? 0)) km) · Yakıt @r.FuelLevelIn?.GetDisplayName()</div> }
                                    </li>
                                    @if (r.Status == ReservationStatus.Cancelled)
                                    {
                                        <li class="bad"><span class="dot"></span><div class="fw-semibold">İptal edildi</div><div class="small text-muted">@r.StatusReason</div></li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <div class="small-caps mb-2">Ücret dökümü</div>
                                <ul class="breakdown">
                                    <li><span>@r.TotalDays gün × @Fmt.Money(r.DailyPrice)</span><span>@Fmt.Money(r.BaseTotal)</span></li>
                                    @if (r.DiscountAmount > 0) { <li class="discount"><span>Uzun dönem indirimi</span><span>− @Fmt.Money(r.DiscountAmount)</span></li> }
                                    @foreach (var e in r.Extras) { <li><span>@e.Extra!.Name</span><span>@Fmt.Money(e.Total)</span></li> }
                                    @if (r.OneWayFee > 0) { <li><span>Tek yön ücreti</span><span>@Fmt.Money(r.OneWayFee)</span></li> }
                                    @if (r.LateFee > 0) { <li><span class="text-danger">Geç iade</span><span>@Fmt.Money(r.LateFee)</span></li> }
                                    @if (r.FuelFee > 0) { <li><span class="text-danger">Eksik yakıt</span><span>@Fmt.Money(r.FuelFee)</span></li> }
                                    @if (r.DamageFee > 0) { <li><span class="text-danger">Hasar</span><span>@Fmt.Money(r.DamageFee)</span></li> }
                                    @if (r.CancellationFee > 0) { <li><span class="text-danger">İptal ücreti</span><span>@Fmt.Money(r.CancellationFee)</span></li> }
                                    <li class="total"><span>Toplam</span><span>@Fmt.Money(r.TotalPrice)</span></li>
                                </ul>
                                <div class="small text-muted mt-2">Depozito: @Fmt.Money(r.Deposit)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (r.DamageReports.Count > 0 || !string.IsNullOrWhiteSpace(r.Notes))
            {
                <div class="col-12">
                    <div class="card">
                        <div class="card-header"><i class="bi bi-chat-left-text me-2 text-brand"></i>Notlar ve hasar</div>
                        <div class="card-body">
                            @if (!string.IsNullOrWhiteSpace(r.Notes)) { <p class="mb-2" style="white-space:pre-line">@r.Notes</p> }
                            @foreach (var dmg in r.DamageReports)
                            {
                                <div class="alert alert-warning py-2 mb-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@dmg.Description — <b>@Fmt.Money(dmg.Cost)</b></div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span><i class="bi bi-wallet2 me-2 text-brand"></i>Ödemeler</span>
                <span class="small @(r.Balance > 0 && !isClosed ? "text-danger" : "text-success") fw-semibold">
                    @(r.Balance > 0 ? $"Kalan {Fmt.Money(r.Balance)}" : "Ödendi")
                </span>
            </div>
            @if (r.Payments.Count == 0) { <div class="card-body small text-muted">Henüz ödeme kaydı yok.</div> }
            <ul class="mini-list">
                @foreach (var p in r.Payments.OrderBy(p => p.PaidAt))
                {
                    <li>
                        <div class="flex-grow-1">
                            <div class="fw-semibold small">@p.Type.GetDisplayName()</div>
                            <div class="meta">@Fmt.DateTime(p.PaidAt) · @p.Method.GetDisplayName()@(p.ReceivedBy is not null ? $" · {p.ReceivedBy.FirstName}" : "")</div>
                        </div>
                        <span class="fw-semibold tabular @(p.Type == PaymentType.DepositRefund ? "text-muted" : "")">@(p.Type == PaymentType.DepositRefund ? "−" : "")@Fmt.Money(p.Amount)</span>
                    </li>
                }
            </ul>
            @if (r.Status is not ReservationStatus.Rejected)
            {
                <form asp-action="AddPayment" method="post" class="card-body border-top">
                    <input type="hidden" name="ReservationId" value="@r.Id" />
                    <div class="small-caps mb-2">Ödeme al</div>
                    <div class="row g-2">
                        <div class="col-6">
                            <input name="Amount" type="number" step="0.01" min="1" class="form-control form-control-sm" value="@payment.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" aria-label="Tutar" required />
                        </div>
                        <div class="col-6">
                            <select name="Method" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<PaymentMethod>()" aria-label="Yöntem"></select>
                        </div>
                        <div class="col-12">
                            <select name="Type" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<PaymentType>()" aria-label="Tür"></select>
                        </div>
                        <div class="col-12">
                            <input name="Note" class="form-control form-control-sm" placeholder="Not (isteğe bağlı)" maxlength="250" />
                        </div>
                        <div class="col-12 d-grid"><button class="btn btn-sm btn-primary">Ödemeyi kaydet</button></div>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="Reject" asp-route-id="@r.Id" method="post" class="modal-content">
            <div class="modal-header"><h2 class="modal-title h5">Talebi reddet</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
            <div class="modal-body">
                <label class="form-label" for="reason">Müşteriye gösterilecek sebep</label>
                <textarea id="reason" name="reason" class="form-control" rows="3" maxlength="250" placeholder="Örn: Ehliyet bilgileri doğrulanamadı."></textarea>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Vazgeç</button><button class="btn btn-danger">Reddet</button></div>
        </form>
    </div>
</div>
